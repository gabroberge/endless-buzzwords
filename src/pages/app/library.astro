---
import AppLayout from "../../layouts/AppLayout.astro";
import { withBase } from "../../lib/paths";
---

<AppLayout title="Library" eyebrow="Archive">
  <section class="library-page">
    <div class="card intro">
      <div class="intro__copy">
        <h2>Your content library</h2>
        <p class="muted">Everything you've created, ready to find, reuse, or put back to work.</p>
      </div>
      <p class="intro__summary" id="summary" aria-live="polite"></p>
    </div>

    <section class="panel library-panel" id="library-panel" hidden>
      <div class="library-toolbar">
        <label class="library-search">
          <span class="sr-only">Search library</span>
          <input id="search" type="search" placeholder="Search titles and topics" autocomplete="off" />
        </label>
        <div class="library-filters" role="tablist" aria-label="Filter by status">
          <button class="library-filter is-active" type="button" data-status="all" role="tab" aria-selected="true">All</button>
          <button class="library-filter" type="button" data-status="draft" role="tab" aria-selected="false">Drafts</button>
          <button class="library-filter" type="button" data-status="published" role="tab" aria-selected="false">Published</button>
        </div>
        <label class="library-topic">
          <span class="sr-only">Filter by topic</span>
          <select id="topic-filter">
            <option value="all">All topics</option>
          </select>
        </label>
      </div>
      <ul id="library-list" class="lib-list" aria-label="Content library"></ul>
      <p class="library-no-matches muted" id="no-matches" hidden>No pieces match your filters.</p>
    </section>

    <div class="card library-empty" id="library-empty" hidden>
      <p class="library-empty__title">Your library is empty</p>
      <p class="library-empty__note muted">
        Compose your first piece and save it here. Everything you create will stay available to reuse later.
      </p>
      <a class="btn btn-accent btn-sm" href={withBase("/app/compose")}>Compose something</a>
    </div>
  </section>
</AppLayout>

<script>
  import type { Draft } from "../../lib/content-engine";
  import { formats } from "../../lib/data/formats";
  import { topicById } from "../../lib/data/topics";
  import { voiceProfiles } from "../../lib/data/voice";
  import {
    findContent,
    getLibraryItems,
    hasActiveQueueEntry,
    libraryCounts,
    libraryStatusOf,
    queueContent,
  } from "../../lib/content-lifecycle";
  import { loadWorkspace, updateWorkspace } from "../../lib/storage";
  import { formatDate, showToast } from "../../lib/ui";

  const channelLabels: Record<string, string> = {
    linkedin: "LinkedIn",
    x: "X",
    youtube: "YouTube",
    facebook: "Facebook",
    newsletter: "Newsletter",
  };

  const formatById = Object.fromEntries(formats.map((f) => [f.id, f.label]));
  const voiceById = Object.fromEntries(voiceProfiles.map((v) => [v.id, v.label]));

  const searchEl = document.getElementById("search") as HTMLInputElement;
  const topicFilterEl = document.getElementById("topic-filter") as HTMLSelectElement;
  const libraryPanel = document.getElementById("library-panel")!;
  const libraryEmpty = document.getElementById("library-empty")!;
  const libraryList = document.getElementById("library-list")!;
  const noMatchesEl = document.getElementById("no-matches")!;

  let statusFilter: "all" | "draft" | "published" = "all";

  function metaParts(parts: string[]): string {
    return parts
      .filter(Boolean)
      .map((part) => `<span>${part}</span>`)
      .join('<span class="lib-row__sep" aria-hidden="true">·</span>');
  }

  function rowAction(ws: ReturnType<typeof loadWorkspace>, draft: Draft): string {
    if (hasActiveQueueEntry(ws, draft.id)) {
      return `<div class="lib-row__action"><span class="lib-row__status">Queued</span></div>`;
    }

    const published = libraryStatusOf(ws, draft) === "published";
    const label = published ? "Re-queue" : "Queue";
    return `<div class="lib-row__action">
      <button class="btn btn-ghost btn-sm" type="button" data-queue="${draft.id}">${label}</button>
    </div>`;
  }

  function contentRow(ws: ReturnType<typeof loadWorkspace>, draft: Draft): string {
    const status = libraryStatusOf(ws, draft);
    const topic = topicById[draft.topicId]?.label ?? draft.topicId;
    const format = formatById[draft.formatId] ?? draft.formatId.replaceAll("-", " ");
    const voice = voiceById[draft.voiceId] ?? draft.voiceId;
    const channel = channelLabels[draft.channelHint] ?? draft.channelHint;

    const meta = metaParts([topic, format, channel, voice, formatDate(draft.createdAt)]);

    return `
      <li class="lib-row">
        <div class="lib-row__main">
          <div class="lib-row__head">
            <span class="lib-row__badge lib-row__badge--${status}">${status === "published" ? "Published" : "Draft"}</span>
            <h4 class="lib-row__title">${draft.title}</h4>
          </div>
          <p class="lib-row__meta">${meta}</p>
        </div>
        ${rowAction(ws, draft)}
      </li>`;
  }

  function queueItem(draft: Draft) {
    const ws = loadWorkspace();
    if (hasActiveQueueEntry(ws, draft.id)) return;
    updateWorkspace((s) => queueContent(s, draft, { status: "queued", when: null }));
    showToast("Queued");
    window.dispatchEvent(new Event("eb:workspace"));
    render();
  }

  function hydrateTopicFilter(items: Draft[]) {
    const current = topicFilterEl.value;
    const topicIds = [...new Set(items.map((item) => item.topicId))].sort((a, b) => {
      const aLabel = topicById[a]?.label ?? a;
      const bLabel = topicById[b]?.label ?? b;
      return aLabel.localeCompare(bLabel);
    });

    topicFilterEl.innerHTML =
      `<option value="all">All topics</option>` +
      topicIds
        .map((id) => `<option value="${id}">${topicById[id]?.label ?? id}</option>`)
        .join("");

    if ([...topicFilterEl.options].some((opt) => opt.value === current)) {
      topicFilterEl.value = current;
    }
  }

  function filteredItems(ws: ReturnType<typeof loadWorkspace>, items: Draft[]): Draft[] {
    const query = searchEl.value.trim().toLowerCase();
    const topic = topicFilterEl.value;

    return items.filter((item) => {
      const status = libraryStatusOf(ws, item);
      if (statusFilter === "draft" && status !== "draft") return false;
      if (statusFilter === "published" && status !== "published") return false;
      if (topic !== "all" && item.topicId !== topic) return false;

      if (!query) return true;
      const topicLabel = topicById[item.topicId]?.label ?? item.topicId;
      const format = formatById[item.formatId] ?? item.formatId;
      const haystack = `${item.title} ${topicLabel} ${format}`.toLowerCase();
      return haystack.includes(query);
    });
  }

  function setStatusFilter(next: "all" | "draft" | "published") {
    statusFilter = next;
    document.querySelectorAll(".library-filter").forEach((btn) => {
      const active = (btn as HTMLElement).dataset.status === next;
      btn.classList.toggle("is-active", active);
      btn.setAttribute("aria-selected", String(active));
    });
    render();
  }

  function render() {
    const ws = loadWorkspace();
    const items = getLibraryItems(ws);
    const counts = libraryCounts(ws);

    const summary = document.getElementById("summary");
    if (summary) {
      summary.textContent = `${counts.total} pieces · ${counts.drafts} drafts · ${counts.published} published`;
    }

    const hasContent = items.length > 0;
    libraryPanel.hidden = !hasContent;
    libraryEmpty.hidden = hasContent;

    if (!hasContent) return;

    hydrateTopicFilter(items);
    const visible = filteredItems(ws, items);

    libraryList.innerHTML = visible.map((item) => contentRow(ws, item)).join("");
    noMatchesEl.hidden = visible.length > 0;
    libraryList.hidden = visible.length === 0;
  }

  searchEl.addEventListener("input", render);
  topicFilterEl.addEventListener("change", render);

  document.querySelectorAll(".library-filter").forEach((btn) => {
    btn.addEventListener("click", () => {
      const status = (btn as HTMLElement).dataset.status as "all" | "draft" | "published";
      setStatusFilter(status);
    });
  });

  libraryList.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest("[data-queue]") as HTMLElement | null;
    if (!btn) return;
    const id = btn.dataset.queue;
    if (!id) return;
    const draft = findContent(loadWorkspace(), id);
    if (!draft) return;
    queueItem(draft);
  });

  render();
  window.addEventListener("eb:workspace", render);
</script>

<style>
  .library-page {
    display: grid;
    gap: 1rem;
  }

  .intro {
    padding: 1.25rem 1.3rem;
    display: grid;
    gap: 0.65rem;
  }

  .intro h2 {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 750;
    margin-bottom: 0.35rem;
  }

  .intro__copy .muted {
    font-size: 0.92rem;
    line-height: 1.55;
    max-width: 42rem;
  }

  .intro__summary {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-muted);
    letter-spacing: 0.01em;
  }

  .library-panel[hidden],
  .library-empty[hidden],
  .library-no-matches[hidden],
  .lib-list[hidden] {
    display: none !important;
  }

  .panel {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--elevated);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .library-toolbar {
    display: grid;
    gap: 0.65rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--line);
    background: #f8fafc;
  }

  .library-search input,
  .library-topic select {
    width: 100%;
    min-height: 40px;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    background: #fff;
    padding: 0.5rem 0.75rem;
    font-weight: 550;
  }

  .library-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .library-filter {
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      background 0.15s var(--ease),
      border-color 0.15s var(--ease),
      color 0.15s var(--ease);
  }

  .library-filter:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .library-filter.is-active {
    border-color: rgba(12, 143, 124, 0.35);
    background: rgba(12, 143, 124, 0.08);
    color: var(--accent-hover);
  }

  .library-no-matches {
    margin: 0;
    padding: 1rem;
    font-size: 0.84rem;
    text-align: center;
  }

  .library-empty {
    padding: 1.35rem 1.4rem;
    display: grid;
    gap: 0.55rem;
    justify-items: start;
  }

  .library-empty__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 750;
    color: var(--ink);
  }

  .library-empty__note {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    max-width: 36rem;
  }

  .lib-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lib-list :global(.lib-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    padding: 0.72rem 1rem;
    border-bottom: 1px solid var(--line);
    transition: background 0.18s var(--ease);
  }

  .lib-list :global(.lib-row:last-child) {
    border-bottom: none;
  }

  .lib-list :global(.lib-row:hover) {
    background: rgba(12, 143, 124, 0.04);
  }

  .lib-list :global(.lib-row__main) {
    min-width: 0;
    flex: 1;
  }

  .lib-list :global(.lib-row__head) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
    margin-bottom: 0.28rem;
  }

  .lib-list :global(.lib-row__badge) {
    display: inline-flex;
    align-items: center;
    padding: 0.14rem 0.48rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .lib-list :global(.lib-row__badge--draft) {
    background: var(--surface-2);
    color: var(--ink-muted);
  }

  .lib-list :global(.lib-row__badge--published) {
    background: rgba(12, 143, 124, 0.12);
    color: var(--accent-hover);
  }

  .lib-list :global(.lib-row__title) {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 750;
    line-height: 1.3;
    color: var(--ink);
    min-width: 0;
  }

  .lib-list :global(.lib-row__meta) {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.28rem 0.35rem;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--ink-muted);
    line-height: 1.35;
  }

  .lib-list :global(.lib-row__sep) {
    color: var(--line-strong, #d0d5dd);
    font-weight: 500;
    user-select: none;
  }

  .lib-list :global(.lib-row__action) {
    flex-shrink: 0;
  }

  .lib-list :global(.lib-row__status) {
    display: inline-flex;
    align-items: center;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--accent-hover);
    letter-spacing: 0.01em;
  }

  .lib-list :global(.lib-row__status--muted) {
    color: var(--ink-muted);
    font-weight: 650;
  }

  @media (min-width: 720px) {
    .library-toolbar {
      grid-template-columns: minmax(0, 1.4fr) auto minmax(10rem, 0.8fr);
      align-items: center;
    }

    .library-filters {
      justify-content: center;
    }
  }

  @media (min-width: 860px) {
    .lib-list :global(.lib-row) {
      padding: 0.68rem 1rem;
    }

    .lib-list :global(.lib-row__action) {
      margin-left: auto;
    }
  }

  @media (max-width: 859px) {
    .lib-list :global(.lib-row) {
      flex-wrap: wrap;
      align-items: flex-start;
    }

    .lib-list :global(.lib-row__action) {
      width: 100%;
      display: flex;
      justify-content: flex-end;
      padding-top: 0.15rem;
    }
  }
</style>
