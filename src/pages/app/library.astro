---
import AppLayout from "../../layouts/AppLayout.astro";
import { withBase } from "../../lib/paths";
---

<AppLayout title="Library" eyebrow="Archive">
  <section class="library-page" id="library-page">
    <div class="card intro">
      <div class="intro__copy">
        <h2>Your content library</h2>
        <p class="muted">Everything you've created, ready to find, reuse, or put back to work.</p>
      </div>
      <p class="intro__summary" id="summary" aria-live="polite"></p>
    </div>

    <section class="panel library-panel" id="library-panel" hidden>
      <div class="library-toolbar">
        <label class="library-search">
          <span class="sr-only">Search library</span>
          <input id="search" type="search" placeholder="Search titles and topics" autocomplete="off" />
        </label>
        <div class="library-filters" role="tablist" aria-label="Filter by status">
          <button class="library-filter is-active" type="button" data-status="all" role="tab" aria-selected="true">All</button>
          <button class="library-filter" type="button" data-status="draft" role="tab" aria-selected="false">Drafts</button>
          <button class="library-filter" type="button" data-status="published" role="tab" aria-selected="false">Published</button>
        </div>
        <label class="library-topic">
          <span class="sr-only">Filter by topic</span>
          <select id="topic-filter">
            <option value="all">All topics</option>
          </select>
        </label>
      </div>
      <ul id="library-list" class="lib-list" aria-label="Content library"></ul>
      <p class="library-no-matches muted" id="no-matches" hidden>No pieces match your filters.</p>
    </section>

    <aside class="lib-preview" id="lib-preview" hidden aria-label="Preview">
      <div class="lib-preview__backdrop" data-preview-backdrop tabindex="-1" aria-hidden="true"></div>
      <div class="lib-preview__panel">
        <header class="lib-preview__head">
          <span class="lib-preview__label">Preview</span>
          <button class="lib-preview__close" type="button" data-preview-close aria-label="Close preview">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
          </button>
        </header>
        <div class="lib-preview__scroll">
          <div class="lib-preview__reading">
            <h2 class="lib-preview__title" id="lib-preview-title"></h2>
            <pre class="lib-preview__body" id="lib-preview-body"></pre>
          </div>
        </div>
      </div>
    </aside>

    <div class="card library-empty" id="library-empty" hidden>
      <p class="library-empty__title">Your library is empty</p>
      <p class="library-empty__note muted">
        Compose your first piece and save it here. Everything you create will stay available to reuse later.
      </p>
      <a class="btn btn-accent btn-sm" href={withBase("/app/compose")}>Compose something</a>
    </div>
  </section>
</AppLayout>

<script>
  import type { Draft } from "../../lib/content-engine";
  import { formats } from "../../lib/data/formats";
  import { topicById } from "../../lib/data/topics";
  import { voiceProfiles } from "../../lib/data/voice";
  import {
    findContent,
    getLibraryItems,
    hasActiveQueueEntry,
    libraryCounts,
    libraryStatusOf,
    queueContent,
  } from "../../lib/content-lifecycle";
  import { loadWorkspace, updateWorkspace } from "../../lib/storage";
  import { formatDate, showToast } from "../../lib/ui";

  const channelLabels: Record<string, string> = {
    linkedin: "LinkedIn",
    x: "X",
    youtube: "YouTube",
    facebook: "Facebook",
    newsletter: "Newsletter",
  };

  const formatById = Object.fromEntries(formats.map((f) => [f.id, f.label]));
  const voiceById = Object.fromEntries(voiceProfiles.map((v) => [v.id, v.label]));

  const searchEl = document.getElementById("search") as HTMLInputElement;
  const topicFilterEl = document.getElementById("topic-filter") as HTMLSelectElement;
  const libraryPanel = document.getElementById("library-panel")!;
  const libraryEmpty = document.getElementById("library-empty")!;
  const libraryList = document.getElementById("library-list")!;
  const noMatchesEl = document.getElementById("no-matches")!;
  const libraryPage = document.getElementById("library-page")!;
  const previewEl = document.getElementById("lib-preview")!;
  const previewBackdrop = previewEl.querySelector<HTMLElement>("[data-preview-backdrop]");
  const previewCloseBtn = previewEl.querySelector<HTMLButtonElement>("[data-preview-close]");

  const previewBodyEl = document.getElementById("lib-preview-body")!;
  const previewTitleEl = document.getElementById("lib-preview-title")!;

  const previewMobileQuery = window.matchMedia("(max-width: 900px)");

  function setPreviewOpen(open: boolean) {
    libraryPage.classList.toggle("library-page--preview-open", open && !previewMobileQuery.matches);
    document.body.classList.toggle("app-drawer-open", open && previewMobileQuery.matches);
  }
  let statusFilter: "all" | "draft" | "published" = "all";
  let openPreviewId: string | null = null;

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function metaParts(parts: string[]): string {
    return parts
      .filter(Boolean)
      .map((part) => `<span>${part}</span>`)
      .join('<span class="lib-row__sep" aria-hidden="true">·</span>');
  }

  function rowAction(ws: ReturnType<typeof loadWorkspace>, draft: Draft): string {
    if (hasActiveQueueEntry(ws, draft.id)) {
      return `<div class="lib-row__action"><span class="lib-row__status">Queued</span></div>`;
    }

    const published = libraryStatusOf(ws, draft) === "published";
    const label = published ? "Re-queue" : "Queue";
    return `<div class="lib-row__action">
      <button class="btn btn-ghost btn-sm" type="button" data-queue="${draft.id}">${label}</button>
    </div>`;
  }

  function contentRow(ws: ReturnType<typeof loadWorkspace>, draft: Draft): string {
    const status = libraryStatusOf(ws, draft);
    const topic = topicById[draft.topicId]?.label ?? draft.topicId;
    const format = formatById[draft.formatId] ?? draft.formatId.replaceAll("-", " ");
    const voice = voiceById[draft.voiceId] ?? draft.voiceId;
    const channel = channelLabels[draft.channelHint] ?? draft.channelHint;

    const meta = metaParts([topic, format, channel, voice, formatDate(draft.createdAt)]);

    return `
      <li class="lib-row" data-inspect="${draft.id}">
        <div class="lib-row__main">
          <div class="lib-row__head">
            <span class="lib-row__badge lib-row__badge--${status}">${status === "published" ? "Published" : "Draft"}</span>
            <h4 class="lib-row__title">${escapeHtml(draft.title)}</h4>
          </div>
          <p class="lib-row__meta">${meta}</p>
        </div>
        ${rowAction(ws, draft)}
      </li>`;
  }

  function setPreviewContent(draft: Draft) {
    previewTitleEl.textContent = draft.title;
    previewBodyEl.textContent = draft.body;
  }

  function openPreview(id: string) {
    const draft = findContent(loadWorkspace(), id);
    if (!draft) return;

    openPreviewId = id;
    setPreviewContent(draft);
    previewEl.hidden = false;
    setPreviewOpen(true);
    previewEl.querySelector(".lib-preview__scroll")?.scrollTo(0, 0);

    document.querySelectorAll("[data-inspect]").forEach((row) => {
      row.classList.toggle("lib-row--previewing", (row as HTMLElement).dataset.inspect === id);
    });
  }

  function closePreview() {
    openPreviewId = null;
    previewEl.hidden = true;
    previewTitleEl.textContent = "";
    previewBodyEl.textContent = "";
    setPreviewOpen(false);
    document.querySelectorAll(".lib-row--previewing").forEach((row) => {
      row.classList.remove("lib-row--previewing");
    });
  }

  function refreshPreview() {
    if (!openPreviewId) return;
    const draft = findContent(loadWorkspace(), openPreviewId);
    if (!draft) {
      closePreview();
      return;
    }
    setPreviewContent(draft);
  }

  function queueItem(draft: Draft) {
    const ws = loadWorkspace();
    if (hasActiveQueueEntry(ws, draft.id)) return;
    updateWorkspace((s) => queueContent(s, draft, { status: "queued", when: null }));
    showToast("Queued");
    window.dispatchEvent(new Event("eb:workspace"));
    render();
  }

  function hydrateTopicFilter(items: Draft[]) {
    const current = topicFilterEl.value;
    const topicIds = [...new Set(items.map((item) => item.topicId))].sort((a, b) => {
      const aLabel = topicById[a]?.label ?? a;
      const bLabel = topicById[b]?.label ?? b;
      return aLabel.localeCompare(bLabel);
    });

    topicFilterEl.innerHTML =
      `<option value="all">All topics</option>` +
      topicIds
        .map((id) => `<option value="${id}">${topicById[id]?.label ?? id}</option>`)
        .join("");

    if ([...topicFilterEl.options].some((opt) => opt.value === current)) {
      topicFilterEl.value = current;
    }
  }

  function filteredItems(ws: ReturnType<typeof loadWorkspace>, items: Draft[]): Draft[] {
    const query = searchEl.value.trim().toLowerCase();
    const topic = topicFilterEl.value;

    return items.filter((item) => {
      const status = libraryStatusOf(ws, item);
      if (statusFilter === "draft" && status !== "draft") return false;
      if (statusFilter === "published" && status !== "published") return false;
      if (topic !== "all" && item.topicId !== topic) return false;

      if (!query) return true;
      const topicLabel = topicById[item.topicId]?.label ?? item.topicId;
      const format = formatById[item.formatId] ?? item.formatId;
      const haystack = `${item.title} ${topicLabel} ${format}`.toLowerCase();
      return haystack.includes(query);
    });
  }

  function setStatusFilter(next: "all" | "draft" | "published") {
    statusFilter = next;
    document.querySelectorAll(".library-filter").forEach((btn) => {
      const active = (btn as HTMLElement).dataset.status === next;
      btn.classList.toggle("is-active", active);
      btn.setAttribute("aria-selected", String(active));
    });
    render();
  }

  function render() {
    const ws = loadWorkspace();
    const items = getLibraryItems(ws);
    const counts = libraryCounts(ws);

    const summary = document.getElementById("summary");
    if (summary) {
      summary.textContent = `${counts.total} pieces · ${counts.drafts} drafts · ${counts.published} published`;
    }

    const hasContent = items.length > 0;
    libraryPanel.hidden = !hasContent;
    libraryEmpty.hidden = hasContent;

    if (!hasContent) return;

    hydrateTopicFilter(items);
    const visible = filteredItems(ws, items);

    libraryList.innerHTML = visible.map((item) => contentRow(ws, item)).join("");
    noMatchesEl.hidden = visible.length > 0;
    libraryList.hidden = visible.length === 0;
    refreshPreview();
  }

  searchEl.addEventListener("input", render);
  topicFilterEl.addEventListener("change", render);

  document.querySelectorAll(".library-filter").forEach((btn) => {
    btn.addEventListener("click", () => {
      const status = (btn as HTMLElement).dataset.status as "all" | "draft" | "published";
      setStatusFilter(status);
    });
  });

  libraryList.addEventListener("click", (e) => {
    const queueBtn = (e.target as HTMLElement).closest("[data-queue]") as HTMLElement | null;
    if (queueBtn) {
      const id = queueBtn.dataset.queue;
      if (!id) return;
      const draft = findContent(loadWorkspace(), id);
      if (!draft) return;
      queueItem(draft);
      return;
    }

    const row = (e.target as HTMLElement).closest("[data-inspect]") as HTMLElement | null;
    if (!row) return;
    const id = row.dataset.inspect;
    if (!id) return;
    openPreview(id);
  });

  previewCloseBtn?.addEventListener("click", closePreview);
  previewBackdrop?.addEventListener("click", closePreview);

  previewMobileQuery.addEventListener("change", () => {
    if (openPreviewId) setPreviewOpen(true);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && openPreviewId) closePreview();
  });

  render();
  window.addEventListener("eb:workspace", render);
</script>

<style>
  .library-page {
    display: grid;
    gap: 1rem;
    --lib-preview-w: clamp(26.25rem, 32vw, 30rem);
  }

  .library-page--preview-open .intro,
  .library-page--preview-open .library-panel,
  .library-page--preview-open .library-empty {
    margin-right: var(--lib-preview-w);
    transition: margin-right 0.2s var(--ease);
  }

  @media (max-width: 900px) {
    .library-page--preview-open .intro,
    .library-page--preview-open .library-panel,
    .library-page--preview-open .library-empty {
      margin-right: 0;
    }
  }

  .intro {
    padding: 1.25rem 1.3rem;
    display: grid;
    gap: 0.65rem;
  }

  .intro h2 {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 750;
    margin-bottom: 0.35rem;
  }

  .intro__copy .muted {
    font-size: 0.92rem;
    line-height: 1.55;
    max-width: 42rem;
  }

  .intro__summary {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-muted);
    letter-spacing: 0.01em;
  }

  .library-panel[hidden],
  .library-empty[hidden],
  .library-no-matches[hidden],
  .lib-list[hidden],
  .lib-preview[hidden] {
    display: none !important;
  }

  .panel {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--elevated);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .library-toolbar {
    display: grid;
    gap: 0.65rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--line);
    background: #f8fafc;
  }

  .library-search input,
  .library-topic select {
    width: 100%;
    min-height: 40px;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    background: #fff;
    padding: 0.5rem 0.75rem;
    font-weight: 550;
  }

  .library-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .library-filter {
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      background 0.15s var(--ease),
      border-color 0.15s var(--ease),
      color 0.15s var(--ease);
  }

  .library-filter:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .library-filter.is-active {
    border-color: rgba(12, 143, 124, 0.35);
    background: rgba(12, 143, 124, 0.08);
    color: var(--accent-hover);
  }

  .library-no-matches {
    margin: 0;
    padding: 1rem;
    font-size: 0.84rem;
    text-align: center;
  }

  .library-empty {
    padding: 1.35rem 1.4rem;
    display: grid;
    gap: 0.55rem;
    justify-items: start;
  }

  .library-empty__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 750;
    color: var(--ink);
  }

  .library-empty__note {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    max-width: 36rem;
  }

  .lib-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lib-list :global(.lib-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    padding: 0.72rem 1rem;
    border-bottom: 1px solid var(--line);
    transition: background 0.18s var(--ease);
    cursor: pointer;
  }

  .lib-list :global(.lib-row:last-child) {
    border-bottom: none;
  }

  .lib-list :global(.lib-row:hover) {
    background: rgba(12, 143, 124, 0.04);
  }

  .lib-list :global(.lib-row__main) {
    min-width: 0;
    flex: 1;
  }

  .lib-list :global(.lib-row__head) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
    margin-bottom: 0.28rem;
  }

  .lib-list :global(.lib-row__badge) {
    display: inline-flex;
    align-items: center;
    padding: 0.14rem 0.48rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .lib-list :global(.lib-row__badge--draft) {
    background: var(--surface-2);
    color: var(--ink-muted);
  }

  .lib-list :global(.lib-row__badge--published) {
    background: rgba(12, 143, 124, 0.12);
    color: var(--accent-hover);
  }

  .lib-list :global(.lib-row__title) {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 750;
    line-height: 1.3;
    color: var(--ink);
    min-width: 0;
  }

  .lib-list :global(.lib-row__meta) {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.28rem 0.35rem;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--ink-muted);
    line-height: 1.35;
  }

  .lib-list :global(.lib-row__sep) {
    color: var(--line-strong, #d0d5dd);
    font-weight: 500;
    user-select: none;
  }

  .lib-list :global(.lib-row--previewing) {
    background: rgba(12, 143, 124, 0.06);
  }

  .lib-list :global(.lib-row__action) {
    flex-shrink: 0;
  }

  .lib-list :global(.lib-row__action button) {
    cursor: pointer;
  }

  .lib-preview {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--lib-preview-w);
    z-index: 20;
    pointer-events: none;
  }

  .lib-preview__backdrop {
    display: none;
  }

  .lib-preview:not([hidden]) {
    pointer-events: auto;
  }

  .lib-preview__panel {
    height: 100%;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    background: #fff;
    border-left: 1px solid var(--line);
    box-shadow: -10px 0 28px rgba(10, 22, 40, 0.06);
  }

  @media (max-width: 900px) {
    .lib-preview {
      inset: 0;
      width: auto;
      z-index: 60;
    }

    .lib-preview__backdrop {
      display: block;
      position: absolute;
      inset: 0;
      background: var(--app-drawer-backdrop-bg);
    }

    .lib-preview__panel {
      position: absolute;
      top: 0;
      right: 0;
      height: 100%;
      width: var(--app-drawer-panel-width-right);
      border-left: none;
      box-shadow: var(--app-drawer-panel-shadow);
    }
  }

  .lib-preview__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.8rem 1.75rem;
    border-bottom: 1px solid var(--line);
    background: #fff;
  }

  .lib-preview__label {
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .lib-preview__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      color 0.15s var(--ease),
      border-color 0.15s var(--ease),
      background 0.15s var(--ease);
  }

  .lib-preview__close:hover {
    color: var(--ink);
    border-color: var(--line-strong);
    background: #f8fafc;
  }

  .lib-preview__scroll {
    overflow-y: auto;
    min-height: 0;
    scrollbar-width: thin;
    scrollbar-color: rgba(10, 22, 40, 0.2) transparent;
  }

  .lib-preview__scroll::-webkit-scrollbar {
    width: 6px;
  }

  .lib-preview__scroll::-webkit-scrollbar-thumb {
    background: rgba(10, 22, 40, 0.18);
    border-radius: 999px;
  }

  .lib-preview__reading {
    padding: 1.75rem 2rem 2rem;
  }

  .lib-preview__title {
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 750;
    margin: 0 0 0.75rem;
    overflow-wrap: anywhere;
    word-break: break-word;
    color: var(--ink);
  }

  .lib-preview__body {
    margin: 0;
    padding: 0;
    white-space: pre-wrap;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .lib-list :global(.lib-row__status) {
    display: inline-flex;
    align-items: center;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--accent-hover);
    letter-spacing: 0.01em;
  }

  .lib-list :global(.lib-row__status--muted) {
    color: var(--ink-muted);
    font-weight: 650;
  }

  @media (min-width: 720px) {
    .library-toolbar {
      grid-template-columns: minmax(0, 1.4fr) auto minmax(10rem, 0.8fr);
      align-items: center;
    }

    .library-filters {
      justify-content: center;
    }
  }

  @media (min-width: 860px) {
    .lib-list :global(.lib-row) {
      padding: 0.68rem 1rem;
    }

    .lib-list :global(.lib-row__action) {
      margin-left: auto;
    }
  }

  @media (max-width: 859px) {
    .lib-list :global(.lib-row) {
      flex-wrap: wrap;
      align-items: flex-start;
    }

    .lib-list :global(.lib-row__action) {
      width: 100%;
      display: flex;
      justify-content: flex-end;
      padding-top: 0.15rem;
    }
  }
</style>
