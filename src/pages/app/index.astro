---
import AppLayout from "../../layouts/AppLayout.astro";
import { withBase } from "../../lib/paths";
---

<AppLayout title="Pipeline" eyebrow="Operations">
  <section class="pipe-page">
    <div class="pipe-ops" id="pipe-ops" aria-label="Pipeline summary" aria-live="polite"></div>

    <section class="panel card">
      <header class="panel__head">
        <h2>Upcoming</h2>
        <div class="panel__actions">
          <div class="schedule-anchor">
            <button class="btn btn-soft btn-sm" type="button" id="schedule-toggle" aria-expanded="false" aria-controls="schedule-panel">
              + Schedule content
            </button>
            <div class="schedule-panel" id="schedule-panel" hidden>
              <div id="schedule-no-channels" class="schedule-panel__notice" hidden>
                <p class="schedule-panel__notice-title">No distribution channels connected</p>
                <p class="schedule-panel__notice-note muted">Connect at least one channel before scheduling content.</p>
                <a class="schedule-panel__link" href={withBase("/app/channels")}>Go to Channels</a>
              </div>
              <div id="schedule-list-view">
                <p class="schedule-panel__label">Add from library</p>
                <ul class="schedule-list" id="schedule-list"></ul>
                <p class="schedule-panel__empty" id="schedule-empty" hidden>
                  <span class="schedule-panel__empty-title">No content available</span>
                  <span class="schedule-panel__empty-note muted">Everything in your library is already queued.</span>
                  <a class="schedule-panel__link" href={withBase("/app/compose")}>Compose something</a>
                </p>
              </div>
              <div id="schedule-form-view" hidden>
                <p class="schedule-panel__label">Schedule content</p>
                <div class="schedule-form">
                  <div class="schedule-form__field">
                    <span class="schedule-form__label">Content</span>
                    <span class="schedule-form__value" id="schedule-form-title"></span>
                  </div>
                  <label class="schedule-form__field">
                    <span class="schedule-form__label">Channel</span>
                    <select id="schedule-form-channel"></select>
                  </label>
                  <label class="schedule-form__field">
                    <span class="schedule-form__label">Date</span>
                    <input type="date" id="schedule-form-date" />
                  </label>
                  <div class="schedule-form__actions">
                    <button class="btn btn-ghost btn-sm" type="button" id="schedule-form-back">Back</button>
                    <button class="btn btn-accent btn-sm" type="button" id="schedule-form-submit">Schedule</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>

      <ul class="upcoming-list" id="upcoming"></ul>
      <div class="upcoming-empty" id="upcoming-empty" hidden>
        <p class="upcoming-empty__title">Nothing scheduled yet</p>
        <p class="upcoming-empty__note muted">Use <strong>Schedule content</strong> to add your next piece.</p>
      </div>
    </section>
  </section>
</AppLayout>

<script>
  import { formats } from "../../lib/data/formats";
  import { channelMarkHtml } from "../../lib/data/channels";
  import { topicById } from "../../lib/data/topics";
  import { voiceProfiles } from "../../lib/data/voice";
  import {
    findContent,
    getAvailableForPipeline,
    getConnectedChannels,
    getQueuedPipelineItems,
    isChannelConnected,
    libraryStatusOf,
    publishPipelineItem,
    queueContent,
    removeFromPipeline,
    schedulePipelineItem,
  } from "../../lib/content-lifecycle";
  import { computeOpsMetrics } from "../../lib/metrics";
  import { loadWorkspace, updateWorkspace, type ChannelId } from "../../lib/storage";
  import {
    defaultScheduleDateInput,
    formatDay,
    fromDateInputValue,
    showToast,
    toDateInputValue,
  } from "../../lib/ui";

  const formatById = Object.fromEntries(formats.map((f) => [f.id, f.label]));
  const voiceById = Object.fromEntries(voiceProfiles.map((v) => [v.id, v.label]));

  const scheduleToggle = document.getElementById("schedule-toggle")!;
  const schedulePanel = document.getElementById("schedule-panel")!;
  const scheduleListView = document.getElementById("schedule-list-view")!;
  const scheduleFormView = document.getElementById("schedule-form-view")!;
  const scheduleNoChannels = document.getElementById("schedule-no-channels")!;
  const scheduleFormTitle = document.getElementById("schedule-form-title")!;
  const scheduleFormChannel = document.getElementById("schedule-form-channel") as HTMLSelectElement;
  const scheduleFormDate = document.getElementById("schedule-form-date") as HTMLInputElement;
  const scheduleFormBack = document.getElementById("schedule-form-back")!;
  const scheduleFormSubmit = document.getElementById("schedule-form-submit")!;
  const upcomingEl = document.getElementById("upcoming")!;
  const upcomingEmpty = document.getElementById("upcoming-empty")!;

  let openMenuId: string | null = null;
  let scheduleMode: "list" | "form" = "list";
  let scheduleDraftId: string | null = null;
  let schedulePipelineId: string | null = null;

  function metaParts(parts: string[]): string {
    return parts
      .filter(Boolean)
      .map((part) => `<span>${part}</span>`)
      .join('<span class="up-row__sep" aria-hidden="true">·</span>');
  }

  function pipelineStatusLabel(status: string): string {
    return status === "scheduled" ? "Scheduled" : status === "queued" ? "Queued" : status;
  }

  function runwayValue(m: ReturnType<typeof computeOpsMetrics>): string {
    if (m.cadenceTarget == null) {
      return `<span class="pipe-ops__value-main">—</span>`;
    }
    if (m.contentRunway === "Unlimited") {
      return `<span class="pipe-ops__value-main">∞</span>`;
    }
    const days = m.scheduledAheadDays;
    const unit = days === 1 ? "day" : "days";
    return `<span class="pipe-ops__value-main">${days}</span> <span class="pipe-ops__value-unit">${unit}</span>`;
  }

  function cadenceState(published: number, target: number | null): "under" | "met" | "over" | "unset" {
    if (target == null) return "unset";
    if (published < target) return "under";
    if (published > target) return "over";
    return "met";
  }

  function opsItem(label: string, value: string, extraClass = ""): string {
    return `
      <div class="pipe-ops__item ${extraClass}">
        <span class="pipe-ops__label">${label}</span>
        <span class="pipe-ops__value">${value}</span>
      </div>`;
  }

  function renderOpsSummary(m: ReturnType<typeof computeOpsMetrics>, upcomingCount: number) {
    const ops = document.getElementById("pipe-ops");
    if (!ops) return;

    const cadence = cadenceState(m.publishedThisWeek, m.cadenceTarget);
    const runwayClass = `pipe-ops__item--runway-${m.runwaySeverity}`;

    ops.innerHTML = `
      <div class="pipe-ops__real">
        ${opsItem("Upcoming", String(upcomingCount))}
        ${opsItem("Runway", runwayValue(m), `pipe-ops__item--runway ${runwayClass}`)}
        ${opsItem(
          "Published this week",
          m.cadenceTarget != null
            ? `<span class="pipe-ops__value-main">${m.publishedThisWeek}</span><span class="pipe-ops__value-sep">/</span><span class="pipe-ops__value-sub">${m.cadenceTarget}</span>`
            : `<span class="pipe-ops__value-main">—</span>`,
          `pipe-ops__item--cadence pipe-ops__item--cadence-${cadence}`,
        )}
      </div>
      <div class="pipe-ops__satire">
        ${opsItem("Authority", m.authorityLevel, "pipe-ops__item--satire")}
        ${opsItem("Original thoughts", String(m.originalThoughts), "pipe-ops__item--satire")}
        ${opsItem("Buzzwords deployed", String(m.buzzwordsDeployed), "pipe-ops__item--satire")}
      </div>`;
  }

  function closeSchedulePanel() {
    schedulePanel.hidden = true;
    scheduleToggle.setAttribute("aria-expanded", "false");
    scheduleMode = "list";
    scheduleDraftId = null;
    schedulePipelineId = null;
  }

  function showScheduleList() {
    scheduleMode = "list";
    scheduleDraftId = null;
    schedulePipelineId = null;
    render();
  }

  function openScheduleForm(ws: ReturnType<typeof loadWorkspace>, draftId: string, pipelineId: string | null = null) {
    const draft = findContent(ws, draftId);
    if (!draft) return;

    scheduleMode = "form";
    scheduleDraftId = draftId;
    schedulePipelineId = pipelineId;

    const item = pipelineId ? ws.pipeline.find((p) => p.id === pipelineId) : null;
    const connected = getConnectedChannels(ws);

    if (connected.length === 0) {
      scheduleListView.hidden = true;
      scheduleFormView.hidden = true;
      scheduleNoChannels.hidden = false;
      return;
    }

    scheduleFormTitle.textContent = draft.title;
    scheduleFormChannel.innerHTML =
      `<option value="" disabled selected>Select channel</option>` +
      connected.map((c) => `<option value="${c.id}">${c.label}</option>`).join("");

    if (item?.channelId && connected.some((c) => c.id === item.channelId)) {
      scheduleFormChannel.value = item.channelId;
    }

    scheduleFormDate.value = item?.when ? toDateInputValue(item.when) : defaultScheduleDateInput(1);

    scheduleListView.hidden = true;
    scheduleFormView.hidden = false;
    scheduleNoChannels.hidden = true;
  }

  function closeRowMenu() {
    if (!openMenuId) return;
    const menu = document.querySelector(`[data-menu-panel="${openMenuId}"]`) as HTMLElement | null;
    const trigger = document.querySelector(`[data-menu-trigger="${openMenuId}"]`) as HTMLElement | null;
    menu?.setAttribute("hidden", "");
    trigger?.setAttribute("aria-expanded", "false");
    openMenuId = null;
  }

  function toggleSchedulePanel() {
    const open = schedulePanel.hidden;
    closeRowMenu();
    schedulePanel.hidden = !open;
    scheduleToggle.setAttribute("aria-expanded", String(open));
    if (open) renderSchedulePanel(loadWorkspace());
  }

  function pickerRow(ws: ReturnType<typeof loadWorkspace>, draft: (typeof ws.drafts)[number]): string {
    const status = libraryStatusOf(ws, draft);
    const topic = topicById[draft.topicId]?.label ?? draft.topicId;
    const format = formatById[draft.formatId] ?? draft.formatId.replaceAll("-", " ");

    return `
      <li>
        <button class="pick-row" type="button" data-pick="${draft.id}">
          <span class="pick-row__badge pick-row__badge--${status}">${status === "published" ? "Published" : "Draft"}</span>
          <span class="pick-row__copy">
            <span class="pick-row__title">${draft.title}</span>
            <span class="pick-row__meta">${metaParts([topic, format])}</span>
          </span>
        </button>
      </li>`;
  }

  function upcomingRow(
    ws: ReturnType<typeof loadWorkspace>,
    item: (typeof ws.pipeline)[number],
    { isNext }: { isNext: boolean },
  ): string {
    const content = findContent(ws, item.draftId);
    const topic = content ? topicById[content.topicId]?.label ?? content.topicId : "";
    const format = content ? formatById[content.formatId] ?? content.formatId.replaceAll("-", " ") : "";
    const voice = content ? voiceById[content.voiceId] ?? content.voiceId : "";
    const isQueued = item.status === "queued";
    const channelConnected = item.channelId ? isChannelConnected(ws, item.channelId) : false;
    const channelMark = item.channelId
      ? channelMarkHtml(item.channelId, { className: "up-row__mark", offline: !channelConnected })
      : `<span class="up-row__mark up-row__mark--unassigned" aria-hidden="true"></span>`;
    const rowClass = [
      "up-row",
      isNext ? "up-row--next" : "",
      isQueued ? "up-row--queued" : "up-row--scheduled",
    ]
      .filter(Boolean)
      .join(" ");

    return `
      <li class="${rowClass}" data-pipeline-id="${item.id}" data-draft-id="${item.draftId}">
        <div class="up-row__body">
          ${channelMark}
          <div class="up-row__main">
            <div class="up-row__head">
              ${isNext ? '<span class="up-row__next">Next</span>' : ""}
              ${!isQueued ? `<span class="up-row__date">${formatDay(item.when)}</span>` : ""}
              <span class="up-row__badge up-row__badge--${item.status}">${pipelineStatusLabel(item.status)}</span>
            </div>
            <h3 class="up-row__title">${item.title}</h3>
            <p class="up-row__meta">${metaParts([topic, format, voice])}</p>
            ${isQueued ? '<p class="up-row__hint">Ready to schedule</p>' : ""}
          </div>
        </div>
        <div class="row-menu">
          <button
            class="row-menu__trigger"
            type="button"
            data-menu-trigger="${item.id}"
            aria-label="Pipeline actions"
            aria-haspopup="menu"
            aria-expanded="false"
          >⋯</button>
          <div class="row-menu__panel" data-menu-panel="${item.id}" role="menu" hidden>
            ${isQueued ? `<button class="row-menu__item" type="button" role="menuitem" data-edit-schedule="${item.id}">Set schedule</button>` : `<button class="row-menu__item" type="button" role="menuitem" data-edit-schedule="${item.id}">Edit schedule</button>`}
            <button class="row-menu__item" type="button" role="menuitem" data-publish="${item.id}">Mark published</button>
            <button class="row-menu__item" type="button" role="menuitem" data-remove="${item.id}">Remove from pipeline</button>
          </div>
        </div>
      </li>`;
  }

  function renderSchedulePanel(ws: ReturnType<typeof loadWorkspace>) {
    const connected = getConnectedChannels(ws);
    const available = getAvailableForPipeline(ws);
    const list = document.getElementById("schedule-list")!;
    const empty = document.getElementById("schedule-empty")!;

    if (connected.length === 0) {
      scheduleNoChannels.hidden = false;
      scheduleListView.hidden = true;
      scheduleFormView.hidden = true;
      return;
    }

    scheduleNoChannels.hidden = true;

    if (scheduleMode === "form" && scheduleDraftId) {
      scheduleListView.hidden = true;
      scheduleFormView.hidden = false;
      return;
    }

    scheduleFormView.hidden = true;
    scheduleListView.hidden = false;

    if (available.length) {
      list.hidden = false;
      empty.hidden = true;
      list.innerHTML = available.map((item) => pickerRow(ws, item)).join("");
    } else {
      list.hidden = true;
      empty.hidden = false;
      list.innerHTML = "";
    }
  }

  function submitScheduleForm() {
    const ws = loadWorkspace();
    const channelId = scheduleFormChannel.value as ChannelId;
    const when = fromDateInputValue(scheduleFormDate.value);

    if (!channelId || !when) {
      showToast("Choose a channel and date");
      return;
    }
    if (!isChannelConnected(ws, channelId)) {
      showToast("That channel is not connected");
      return;
    }

    if (schedulePipelineId) {
      updateWorkspace((s) => schedulePipelineItem(s, schedulePipelineId!, { channelId, when }));
      showToast("Schedule updated");
    } else if (scheduleDraftId) {
      const draft = findContent(ws, scheduleDraftId);
      if (!draft) return;
      updateWorkspace((s) =>
        queueContent(s, draft, {
          channelId,
          when,
          status: "scheduled",
        }),
      );
      showToast("Scheduled");
    }

    closeSchedulePanel();
    render();
    window.dispatchEvent(new Event("eb:workspace"));
  }

  function render() {
    const ws = loadWorkspace();
    const m = computeOpsMetrics(ws);
    const upcoming = getQueuedPipelineItems(ws);
    const nextScheduledId = upcoming.find((item) => item.status === "scheduled")?.id;

    renderOpsSummary(m, upcoming.length);
    renderSchedulePanel(ws);

    if (upcoming.length) {
      upcomingEl.hidden = false;
      upcomingEmpty.hidden = true;
      upcomingEl.innerHTML = upcoming
        .map((item) => upcomingRow(ws, item, { isNext: item.id === nextScheduledId }))
        .join("");
    } else {
      upcomingEl.hidden = true;
      upcomingEmpty.hidden = false;
      upcomingEl.innerHTML = "";
    }

    closeRowMenu();
  }

  scheduleToggle.addEventListener("click", (e) => {
    e.stopPropagation();
    toggleSchedulePanel();
  });

  schedulePanel.addEventListener("click", (e) => {
    e.stopPropagation();
    const pickBtn = (e.target as HTMLElement).closest("[data-pick]") as HTMLElement | null;
    if (!pickBtn) return;
    const id = pickBtn.dataset.pick;
    if (!id) return;
    openScheduleForm(loadWorkspace(), id);
  });

  scheduleFormBack.addEventListener("click", (e) => {
    e.stopPropagation();
    showScheduleList();
  });

  scheduleFormSubmit.addEventListener("click", (e) => {
    e.stopPropagation();
    submitScheduleForm();
  });

  upcomingEl.addEventListener("click", (e) => {
    e.stopPropagation();

    const queuedRow = (e.target as HTMLElement).closest(".up-row--queued") as HTMLElement | null;
    if (queuedRow && !(e.target as HTMLElement).closest(".row-menu")) {
      const pipelineId = queuedRow.dataset.pipelineId;
      const draftId = queuedRow.dataset.draftId;
      if (pipelineId && draftId) {
        closeRowMenu();
        schedulePanel.hidden = false;
        scheduleToggle.setAttribute("aria-expanded", "true");
        openScheduleForm(loadWorkspace(), draftId, pipelineId);
        return;
      }
    }

    const trigger = (e.target as HTMLElement).closest("[data-menu-trigger]") as HTMLElement | null;
    if (trigger) {
      e.stopPropagation();
      const id = trigger.dataset.menuTrigger!;
      if (openMenuId === id) {
        closeRowMenu();
        return;
      }
      closeRowMenu();
      const panel = document.querySelector(`[data-menu-panel="${id}"]`) as HTMLElement;
      panel.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
      openMenuId = id;
      return;
    }

    const editBtn = (e.target as HTMLElement).closest("[data-edit-schedule]") as HTMLElement | null;
    if (editBtn) {
      const id = editBtn.dataset.editSchedule;
      if (!id) return;
      const ws = loadWorkspace();
      const item = ws.pipeline.find((p) => p.id === id);
      if (!item) return;
      closeRowMenu();
      schedulePanel.hidden = false;
      scheduleToggle.setAttribute("aria-expanded", "true");
      openScheduleForm(ws, item.draftId, item.id);
      return;
    }

    const publishBtn = (e.target as HTMLElement).closest("[data-publish]") as HTMLElement | null;
    if (publishBtn) {
      const id = publishBtn.dataset.publish;
      if (!id) return;
      updateWorkspace((s) => publishPipelineItem(s, id));
      showToast("Marked as published");
      closeRowMenu();
      render();
      window.dispatchEvent(new Event("eb:workspace"));
      return;
    }

    const removeBtn = (e.target as HTMLElement).closest("[data-remove]") as HTMLElement | null;
    if (removeBtn) {
      const id = removeBtn.dataset.remove;
      if (!id) return;
      updateWorkspace((s) => removeFromPipeline(s, id));
      showToast("Removed from pipeline");
      closeRowMenu();
      render();
      window.dispatchEvent(new Event("eb:workspace"));
    }
  });

  document.addEventListener("click", () => {
    closeSchedulePanel();
    closeRowMenu();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeSchedulePanel();
      closeRowMenu();
    }
  });

  render();
  window.addEventListener("eb:workspace", render);
</script>

<style>
  .pipe-page {
    display: grid;
    gap: 0.65rem;
  }

  .pipe-ops {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0;
    margin: 0;
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.72);
  }

  .pipe-ops :global(.pipe-ops__real),
  .pipe-ops :global(.pipe-ops__satire) {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    align-items: stretch;
  }

  .pipe-ops :global(.pipe-ops__satire) {
    border-left: 1px solid var(--line);
    margin-left: 0.35rem;
    padding-left: 0.35rem;
  }

  .pipe-ops :global(.pipe-ops__item) {
    display: grid;
    gap: 0.04rem;
    flex: 1 1 4.75rem;
    min-width: 0;
    padding: 0 0.6rem;
    border-right: 1px solid var(--line);
  }

  .pipe-ops :global(.pipe-ops__real .pipe-ops__item:first-child),
  .pipe-ops :global(.pipe-ops__satire .pipe-ops__item:first-child) {
    padding-left: 0.1rem;
  }

  .pipe-ops :global(.pipe-ops__real .pipe-ops__item:last-child),
  .pipe-ops :global(.pipe-ops__satire .pipe-ops__item:last-child) {
    border-right: none;
    padding-right: 0.1rem;
  }

  .pipe-ops :global(.pipe-ops__value) {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .pipe-ops :global(.pipe-ops__value-main) {
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
  }

  .pipe-ops :global(.pipe-ops__value-unit),
  .pipe-ops :global(.pipe-ops__value-sub) {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0;
    color: var(--ink-muted);
  }

  .pipe-ops :global(.pipe-ops__value-sep) {
    margin: 0 0.08rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .pipe-ops :global(.pipe-ops__label) {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .pipe-ops :global(.pipe-ops__item--satire .pipe-ops__value) {
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink-soft);
  }

  .pipe-ops :global(.pipe-ops__item--satire .pipe-ops__label) {
    font-size: 0.62rem;
    letter-spacing: 0.03em;
  }

  .pipe-ops :global(.pipe-ops__item--runway-unset .pipe-ops__value),
  .pipe-ops :global(.pipe-ops__item--runway-unset .pipe-ops__label) {
    color: var(--ink-muted);
  }

  .pipe-ops :global(.pipe-ops__item--cadence-unset .pipe-ops__value-main) {
    color: var(--ink-muted);
  }

  .pipe-ops :global(.pipe-ops__item--runway-danger .pipe-ops__value),
  .pipe-ops :global(.pipe-ops__item--runway-danger .pipe-ops__label) {
    color: var(--danger);
  }

  .pipe-ops :global(.pipe-ops__item--runway-warning .pipe-ops__value) {
    color: var(--warm);
  }

  .pipe-ops :global(.pipe-ops__item--runway-warning .pipe-ops__label) {
    color: #9a6a28;
  }

  .pipe-ops :global(.pipe-ops__item--runway-healthy .pipe-ops__value) {
    color: var(--success);
  }

  .pipe-ops :global(.pipe-ops__item--runway-healthy .pipe-ops__label) {
    color: var(--accent-hover);
  }

  .pipe-ops :global(.pipe-ops__item--cadence-under .pipe-ops__value-main) {
    color: var(--warm);
  }

  .pipe-ops :global(.pipe-ops__item--cadence-met .pipe-ops__value-main) {
    color: var(--accent-hover);
  }

  .pipe-ops :global(.pipe-ops__item--cadence-over .pipe-ops__value-main) {
    color: var(--ink);
  }

  .panel {
    padding: 1rem 1.05rem 1.15rem;
  }

  .panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .panel__head h2 {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 750;
    margin: 0;
  }

  .panel__actions {
    position: relative;
    flex-shrink: 0;
  }

  .schedule-anchor {
    position: relative;
  }

  .schedule-panel {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    z-index: 12;
    width: min(22rem, calc(100vw - 2.5rem));
    padding: 0.65rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: var(--shadow-sm);
  }

  .schedule-panel[hidden] {
    display: none !important;
  }

