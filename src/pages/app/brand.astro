---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Brand" eyebrow="Configuration">
  <section class="brand-page">
    <form class="card form" id="form">
      <label class="field">
        Brand name
        <input id="brand" type="text" maxlength="80" />
      </label>

      <label class="field">
        Default voice
        <select id="voice"></select>
      </label>

      <label class="field">
        Weekly cadence target
        <input id="cadence" type="number" min="1" max="21" placeholder="—" />
      </label>

      <fieldset class="field-group">
        <legend>Byline</legend>
        <div id="byline" class="choices"></div>
      </fieldset>

      <fieldset class="field-group">
        <legend>Focus topics</legend>
        <div id="topics" class="topics"></div>
      </fieldset>

      <div class="actions">
        <button class="btn btn-accent" type="submit">Save brand</button>
        <button class="btn btn-ghost" type="button" id="reset">Reset desk</button>
      </div>
    </form>

    <aside class="card aside">
      <h2>How brand settings are used</h2>
      <p class="muted">
        Voice sets the default seniority in Compose. Cadence is your weekly posting target on Pipeline. Byline controls attribution — and how much human presence shows up.
      </p>
      <ul>
        <li>Focus topics bias Compose defaults</li>
        <li>Channel connections live under Channels</li>
        <li>Workspace state persists in localStorage</li>
      </ul>
      <p class="muted tiny" id="density"></p>
    </aside>
  </section>
</AppLayout>

<script>
  import { topics } from "../../lib/data/topics";
  import { bylineModes, voiceProfiles } from "../../lib/data/voice";
  import { computeOpsMetrics } from "../../lib/metrics";
  import { loadWorkspace, resetWorkspace, updateWorkspace } from "../../lib/storage";
  import { showToast } from "../../lib/ui";

  const brandEl = document.getElementById("brand") as HTMLInputElement;
  const voiceEl = document.getElementById("voice") as HTMLSelectElement;
  const cadenceEl = document.getElementById("cadence") as HTMLInputElement;
  const bylineEl = document.getElementById("byline")!;
  const topicsEl = document.getElementById("topics")!;
  const densityEl = document.getElementById("density")!;

  function hydrate() {
    const ws = loadWorkspace();
    brandEl.value = ws.brandName;
    cadenceEl.value = ws.cadenceTarget != null ? String(ws.cadenceTarget) : "";
    voiceEl.innerHTML =
      `<option value="" ${ws.voiceId ? "" : "selected"} disabled hidden>Select a voice</option>` +
      voiceProfiles
        .map((v) => `<option value="${v.id}" ${v.id === ws.voiceId ? "selected" : ""}>${v.label} — ${v.description}</option>`)
        .join("");
    bylineEl.innerHTML = bylineModes
      .map(
        (b) => `
      <label class="choice choice--radio">
        <input type="radio" name="byline" value="${b.id}" ${ws.bylineId === b.id ? "checked" : ""} />
        <span class="choice__text">
          <span class="choice__title">${b.label}</span>
          <span class="choice__note">${b.note}</span>
        </span>
      </label>`,
      )
      .join("");
    topicsEl.innerHTML = topics
      .map(
        (t) => `
      <label class="choice choice--check">
        <input type="checkbox" value="${t.id}" ${ws.focusTopics.includes(t.id) ? "checked" : ""} />
        <span class="choice__title">${t.label}</span>
      </label>`,
      )
      .join("");
    densityEl.textContent = `Original thoughts: ${computeOpsMetrics(ws).originalThoughts} · Human presence: ${computeOpsMetrics(ws).humanReview.toLowerCase()}`;
  }

  document.getElementById("form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const byline = (document.querySelector('input[name="byline"]:checked') as HTMLInputElement | null)?.value;
    const focusTopics = [...topicsEl.querySelectorAll("input:checked")].map((el) => (el as HTMLInputElement).value);
    const cadenceRaw = cadenceEl.value.trim();
    const cadenceParsed = cadenceRaw ? Math.min(21, Math.max(1, Number(cadenceRaw))) : null;

    updateWorkspace((s) => ({
      ...s,
      brandName: brandEl.value.trim(),
      voiceId: voiceEl.value ? (voiceEl.value as typeof s.voiceId) : null,
      bylineId: byline ? (byline as typeof s.bylineId) : null,
      cadenceTarget: Number.isFinite(cadenceParsed) ? cadenceParsed : null,
      focusTopics,
    }));
    showToast("Brand settings saved");
    window.dispatchEvent(new Event("eb:workspace"));
    hydrate();
  });

  document.getElementById("reset")?.addEventListener("click", () => {
    if (!window.confirm("Reset this desk? Drafts, pipeline changes, and channel connections will be cleared.")) return;
    resetWorkspace();
    hydrate();
    showToast("Desk reset");
    window.dispatchEvent(new Event("eb:workspace"));
  });

  hydrate();
</script>

<style>
  .brand-page {
    display: grid;
    gap: 1rem;
  }

  .form,
  .aside {
    padding: 1.2rem;
  }

  .form {
    display: grid;
    gap: 1.25rem;
  }

  .field,
  .field-group {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    border: none;
    padding: 0;
  }

  .field {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-muted);
  }

  .field-group > legend {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-muted);
    padding: 0;
  }

  .field-group .choices,
  .field-group .topics {
    margin-top: 0.15rem;
  }

  input[type="text"],
  input[type="number"],
  select {
    min-height: 44px;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    background: #fff;
    padding: 0.55rem 0.75rem;
    color: var(--ink);
    font-weight: 550;
    text-transform: none;
    letter-spacing: normal;
  }

  .choices {
    display: grid;
    gap: 0.55rem;
  }

  .topics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  /* Injected client-side — must use :global() for Astro scoped styles */
  .choices :global(.choice),
  .topics :global(.choice) {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 0.8rem 0.85rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: #fff;
    cursor: pointer;
    min-width: 0;
    transition:
      border-color 0.2s var(--ease),
      background 0.2s var(--ease);
  }

  .choices :global(.choice:hover),
  .topics :global(.choice:hover) {
    border-color: var(--line-strong);
    background: #fbfcfe;
  }

  .choices :global(.choice:has(:checked)),
  .topics :global(.choice:has(:checked)) {
    border-color: rgba(12, 143, 124, 0.35);
    background: rgba(12, 143, 124, 0.04);
  }

  .choices :global(.choice input),
  .topics :global(.choice input) {
    margin: 0.12rem 0 0;
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
    accent-color: var(--accent);
  }

  .topics :global(.choice--check) {
    align-items: center;
    padding: 0.65rem 0.8rem;
  }

  .topics :global(.choice--check input) {
    margin-top: 0;
  }

  .choices :global(.choice__text) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    flex: 1;
  }

  .choices :global(.choice__title),
  .topics :global(.choice__title) {
    display: block;
    font-size: 0.92rem;
    font-weight: 650;
    color: var(--ink);
    line-height: 1.3;
  }

  .choices :global(.choice__note) {
    display: block;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink-muted);
    line-height: 1.45;
  }

  .topics :global(.choice__title) {
    font-size: 0.88rem;
    font-weight: 600;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding-top: 0.15rem;
  }

  .aside h2 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .aside ul {
    margin-top: 1rem;
    display: grid;
    gap: 0.45rem;
  }

  .aside li {
    font-size: 0.92rem;
    color: var(--ink-muted);
    padding-left: 0.9rem;
    position: relative;
  }

  .aside li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .tiny {
    margin-top: 1.25rem;
    font-size: 0.85rem;
  }

  @media (min-width: 900px) {
    .brand-page {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: start;
    }
  }
</style>
