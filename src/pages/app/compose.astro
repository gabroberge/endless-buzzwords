---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Compose" eyebrow="Create">
  <section class="compose">
    <aside class="card controls">
      <label id="topic-field">
        Topic
        <select id="topic"></select>
      </label>
      <div id="topic-empty" class="topic-empty" hidden>
        <p class="topic-empty__title">No focus topics configured</p>
        <p class="topic-empty__note muted">Add topics to your brand before composing technical authority.</p>
        <a class="btn btn-accent btn-sm" href="/app/brand">Configure brand</a>
      </div>
      <label>
        Format
        <select id="format"></select>
      </label>
      <label>
        Voice
        <select id="voice"></select>
      </label>

      <div class="btn-stack">
        <button class="btn btn-accent" type="button" id="generate">Compose</button>
        <button class="btn btn-ghost" type="button" id="again">Compose again</button>
      </div>

      <p class="hint muted">Transform</p>
      <div class="transform-grid">
        <button class="btn btn-soft btn-sm" type="button" data-action="senior">Make it more senior</button>
        <button class="btn btn-soft btn-sm" type="button" data-action="buzzwords">Add buzzwords</button>
        <button class="btn btn-soft btn-sm" type="button" data-action="urgency">Add urgency</button>
        <button class="btn btn-soft btn-sm" type="button" data-action="thought-leadership">Make it thought leadership</button>
        <button class="btn btn-soft btn-sm" type="button" data-action="interview">Turn into interview question</button>
        <button class="btn btn-soft btn-sm" type="button" data-action="roadmap">Repackage as roadmap</button>
        <button class="btn btn-soft btn-sm" type="button" data-action="tradeoff">Add a tradeoff</button>
        <button class="btn btn-soft btn-sm" type="button" data-action="production">Add production framing</button>
        <button class="btn btn-soft btn-sm" type="button" data-action="linkedin">Repackage for LinkedIn</button>
        <button class="btn btn-soft btn-sm" type="button" data-action="x">Compress for X</button>
      </div>

      <div class="persist-actions">
        <button class="btn btn-primary btn-sm" type="button" id="save">Save to library</button>
        <button class="btn btn-ghost btn-sm" type="button" id="queue">Queue to pipeline</button>
        <button class="btn btn-ghost btn-sm" type="button" id="copy">Copy</button>
      </div>
    </aside>

    <article class="card canvas" aria-live="polite">
      <header class="canvas__meta">
        <span class="badge" id="channel">linkedin</span>
        <span class="badge badge-muted" id="authority">Authority —</span>
        <span class="badge badge-muted" id="buzzwords">Buzzwords —</span>
        <span class="badge badge-muted" id="engagement">Engagement —</span>
        <span class="badge badge-warm" id="voice-badge">Voice</span>
      </header>
      <h2 id="title">Draft appears here</h2>
      <pre id="body">Choose a topic and format, then compose.</pre>
    </article>
  </section>
</AppLayout>

<script>
  import {
    applyTransform,
    authorityLabel,
    composeDraft,
    draftText,
    formats,
    getTransformControlState,
    type Draft,
    type TransformAction,
  } from "../../lib/content-engine";
  import { topics } from "../../lib/data/topics";
  import { voiceProfiles } from "../../lib/data/voice";
  import { loadWorkspace, updateWorkspace } from "../../lib/storage";
  import { showToast } from "../../lib/ui";

  const topicFieldEl = document.getElementById("topic-field")!;
  const topicEmptyEl = document.getElementById("topic-empty")!;
  const topicEl = document.getElementById("topic") as HTMLSelectElement;
  const formatEl = document.getElementById("format") as HTMLSelectElement;
  const voiceEl = document.getElementById("voice") as HTMLSelectElement;
  const titleEl = document.getElementById("title")!;
  const bodyEl = document.getElementById("body")!;
  const channelEl = document.getElementById("channel")!;
  const authorityEl = document.getElementById("authority")!;
  const buzzwordsEl = document.getElementById("buzzwords")!;
  const engagementEl = document.getElementById("engagement")!;
  const voiceBadge = document.getElementById("voice-badge")!;

  let current: Draft | null = null;
  let composeReady = false;

  function availableTopics(focusTopicIds: string[]) {
    return focusTopicIds
      .map((id) => topics.find((t) => t.id === id))
      .filter((topic): topic is (typeof topics)[number] => Boolean(topic));
  }

  function setComposeEnabled(enabled: boolean) {
    composeReady = enabled;
    const toggle = (id: string, on: boolean) => {
      const el = document.getElementById(id) as HTMLButtonElement | null;
      if (el) el.disabled = !on;
    };

    toggle("generate", enabled);
    toggle("again", enabled);
    toggle("save", enabled);
    toggle("queue", enabled);
    toggle("copy", enabled);

    document.querySelectorAll("[data-action]").forEach((btn) => {
      (btn as HTMLButtonElement).disabled = !enabled;
    });
  }

  function showEmptyCanvas() {
    current = null;
    titleEl.textContent = "No focus topics configured";
    bodyEl.textContent = "Add topics to your brand before composing technical authority.";
    channelEl.textContent = "—";
    authorityEl.textContent = "Authority —";
    buzzwordsEl.textContent = "Buzzwords —";
    engagementEl.textContent = "Engagement —";
    voiceBadge.textContent = "Voice";
    document.querySelectorAll("[data-action]").forEach((btn) => {
      const button = btn as HTMLButtonElement;
      button.disabled = true;
      button.title = "";
    });
  }

  function hydrateTopics() {
    const ws = loadWorkspace();
    const available = availableTopics(ws.focusTopics);
    const previous = topicEl.value;

    if (!available.length) {
      topicFieldEl.hidden = true;
      topicEmptyEl.hidden = false;
      topicEl.innerHTML = "";
      setComposeEnabled(false);
      showEmptyCanvas();
      return;
    }

    topicFieldEl.hidden = false;
    topicEmptyEl.hidden = true;
    topicEl.innerHTML = available.map((t) => `<option value="${t.id}">${t.label}</option>`).join("");

    const selectedId = available.some((t) => t.id === previous) ? previous : available[0]!.id;
    topicEl.value = selectedId;
    setComposeEnabled(true);

    if (current && !available.some((t) => t.id === current!.topicId)) {
      current = null;
    }
  }

  const ws = loadWorkspace();
  formatEl.innerHTML = formats.map((f) => `<option value="${f.id}">${f.label}</option>`).join("");
  voiceEl.innerHTML = voiceProfiles
    .map((v) => `<option value="${v.id}" ${v.id === ws.voiceId ? "selected" : ""}>${v.label}</option>`)
    .join("");

  function engagementLabel(signal: number): string {
    if (signal >= 75) return "High";
    if (signal >= 60) return "Medium";
    return "Low";
  }

  function render(draft: Draft) {
    current = draft;
    titleEl.textContent = draft.title;
    bodyEl.textContent = draft.body;
    channelEl.textContent = draft.channelHint;
    authorityEl.textContent = `Authority: ${authorityLabel(draft.authorityTier ?? 0)}`;
    buzzwordsEl.textContent = `Buzzwords: ${draft.buzzwordCount ?? 0}`;
    engagementEl.textContent = `Engagement: ${engagementLabel(draft.signal)}`;
    voiceBadge.textContent = voiceProfiles.find((v) => v.id === draft.voiceId)?.label ?? draft.voiceId;
    updateTransformControls(draft);
  }

  function updateTransformControls(draft: Draft) {
    document.querySelectorAll("[data-action]").forEach((btn) => {
      const action = (btn as HTMLElement).dataset.action as TransformAction;
      const state = getTransformControlState(draft, action);
      const button = btn as HTMLButtonElement;
      button.disabled = state.disabled;
      button.textContent = state.label;
      button.title = state.hint ?? "";
    });
  }

  function create() {
    if (!composeReady || !topicEl.value) return;
    render(
      composeDraft({
        topicId: topicEl.value,
        formatId: formatEl.value as any,
        voiceId: voiceEl.value as any,
      }),
    );
  }

  document.getElementById("generate")?.addEventListener("click", create);
  document.getElementById("again")?.addEventListener("click", create);

  document.querySelectorAll("[data-action]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!current) {
        create();
        return;
      }
      const action = (btn as HTMLElement).dataset.action as TransformAction;
      const outcome = applyTransform(current, action);
      render(outcome.draft);
      if (!outcome.applied) {
        showToast(outcome.message);
        return;
      }
      if (action === "linkedin" || action === "x") {
        showToast("Variant created without additional source material");
      } else if (outcome.terminal) {
        showToast(outcome.message);
      } else {
        showToast("Draft updated");
      }
    });
  });

  document.getElementById("save")?.addEventListener("click", () => {
    if (!current) return;
    updateWorkspace((s) => ({
      ...s,
      drafts: [current!, ...s.drafts.filter((d) => d.id !== current!.id)].slice(0, 50),
    }));
    showToast("Saved to library");
    window.dispatchEvent(new Event("eb:workspace"));
  });

  document.getElementById("queue")?.addEventListener("click", () => {
    if (!current) return;
    const channelId =
      current.channelHint === "x" ? "x" : current.channelHint === "youtube" ? "youtube" : "linkedin";
    updateWorkspace((s) => ({
      ...s,
      drafts: [current!, ...s.drafts.filter((d) => d.id !== current!.id)].slice(0, 50),
      pipeline: [
        {
          id: `p_${Date.now()}`,
          draftId: current!.id,
          title: current!.title,
          channelId,
          when: new Date(Date.now() + 86400000 * 2).toISOString(),
          status: "scheduled" as const,
        },
        ...s.pipeline,
      ],
    }));
    showToast("Queued to pipeline");
    window.dispatchEvent(new Event("eb:workspace"));
  });

  document.getElementById("copy")?.addEventListener("click", async () => {
    if (!current) return;
    await navigator.clipboard.writeText(draftText(current));
    showToast("Copied");
  });

  hydrateTopics();
  if (composeReady) create();

  window.addEventListener("eb:workspace", hydrateTopics);
</script>

<style>
  .compose {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .controls,
  .canvas {
    padding: 1.15rem;
    min-width: 0;
  }

  .controls {
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }

  label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-muted);
  }

  #topic-field[hidden] {
    display: none !important;
  }

  .topic-empty[hidden] {
    display: none !important;
  }

  .topic-empty:not([hidden]) {
    display: grid;
    gap: 0.55rem;
    padding: 0.85rem 0.9rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: #f8fafc;
  }

  select {
    min-height: 44px;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    background: #fff;
    padding: 0.5rem 0.75rem;
  }

  .topic-empty__title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 750;
    color: var(--ink);
  }

  .topic-empty__note {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .topic-empty .btn {
    justify-self: start;
    margin-top: 0.15rem;
  }

  .controls :is(button, select):disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .btn-stack,
  .persist-actions,
  .transform-grid {
    display: grid;
    gap: 0.45rem;
  }

  .transform-grid .btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    white-space: normal;
    line-height: 1.25;
    text-align: center;
  }

  .hint {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 0.25rem;
  }

  .canvas__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .canvas h2 {
    font-size: 1.3rem;
    margin-bottom: 0.85rem;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .canvas pre {
    margin: 0;
    white-space: pre-wrap;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--ink-soft);
    min-height: 12rem;
    max-height: min(52vh, 28rem);
    overflow-x: hidden;
    overflow-y: auto;
    overflow-wrap: anywhere;
    word-break: break-word;
    padding-right: 0.25rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(10, 22, 40, 0.2) transparent;
  }

  .canvas pre::-webkit-scrollbar {
    width: 6px;
  }

  .canvas pre::-webkit-scrollbar-thumb {
    background: rgba(10, 22, 40, 0.18);
    border-radius: 999px;
  }

  @media (min-width: 960px) {
    .compose {
      grid-template-columns: 300px 1fr;
      align-items: start;
    }
  }
</style>
