---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Compose" eyebrow="Create">
  <section class="compose">
    <aside class="card controls controls--idle" id="controls">
      <div class="controls__setup">
        <label id="topic-field">
          Topic
          <select id="topic"></select>
        </label>
        <div id="topic-empty" class="topic-empty" hidden>
          <p class="topic-empty__title">No focus topics configured</p>
          <p class="topic-empty__note muted">Add topics to your brand before composing technical authority.</p>
          <a class="btn btn-accent btn-sm" href="/app/brand">Configure brand</a>
        </div>
        <label>
          Format
          <select id="format"></select>
        </label>
        <label>
          Voice
          <select id="voice"></select>
        </label>
        <button class="btn btn-accent" type="button" id="generate">Compose</button>
      </div>

      <div class="controls__section" id="transform-section">
        <p class="hint muted">Transform</p>
        <div class="transform-grid">
          <button class="btn btn-soft btn-sm" type="button" data-action="senior">Make it more senior</button>
          <button class="btn btn-soft btn-sm" type="button" data-action="buzzwords">Add buzzwords</button>
          <button class="btn btn-soft btn-sm" type="button" data-action="urgency">Add urgency</button>
          <button class="btn btn-soft btn-sm" type="button" data-action="thought-leadership">Make it thought leadership</button>
          <button class="btn btn-soft btn-sm" type="button" data-action="interview">Turn into interview question</button>
          <button class="btn btn-soft btn-sm" type="button" data-action="roadmap">Repackage as roadmap</button>
          <button class="btn btn-soft btn-sm" type="button" data-action="tradeoff">Add a tradeoff</button>
          <button class="btn btn-soft btn-sm" type="button" data-action="production">Add production framing</button>
          <button class="btn btn-soft btn-sm" type="button" data-action="linkedin">Repackage for LinkedIn</button>
          <button class="btn btn-soft btn-sm" type="button" data-action="x">Compress for X</button>
        </div>
      </div>

      <div class="controls__section controls__section--actions" id="persist-section">
        <div class="split-btn" id="persist-split">
          <button class="btn btn-primary btn-sm split-btn__main" type="button" id="save">Save to library</button>
          <div class="split-btn__menu">
            <button
              class="btn btn-primary btn-sm split-btn__trigger"
              type="button"
              id="persist-menu"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-label="More save options"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M6 9l6 6 6-6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
            <div class="split-btn__dropdown" id="persist-dropdown" role="menu" hidden>
              <button class="split-btn__option" type="button" role="menuitem" data-persist="save">Save to library</button>
              <button class="split-btn__option" type="button" role="menuitem" data-persist="queue">Queue to pipeline</button>
            </div>
          </div>
        </div>
      </div>
    </aside>

    <article class="card canvas canvas--idle" id="canvas" aria-live="polite">
      <button
        class="canvas__copy"
        type="button"
        id="copy"
        title="Copy to clipboard"
        aria-label="Copy to clipboard"
        hidden
        disabled
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="8" y="8" width="14" height="14" rx="2" stroke="currentColor" stroke-width="2"></rect>
          <path
            d="M4 16V4c0-1.1.9-2 2-2h10"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
      <div class="canvas__idle" id="canvas-idle">
        <p class="canvas__idle-title">No draft yet</p>
        <p class="canvas__idle-note muted">Choose topic, format, and voice — then compose.</p>
      </div>
      <div class="canvas__content" id="canvas-content" hidden>
        <header class="canvas__meta" id="canvas-meta">
          <span class="badge" id="channel">linkedin</span>
          <span class="badge badge-muted" id="authority">Authority —</span>
          <span class="badge badge-muted" id="buzzwords">Buzzwords —</span>
          <span class="badge badge-muted" id="engagement">Engagement —</span>
          <span class="badge badge-warm" id="voice-badge">Voice</span>
        </header>
        <h2 id="title"></h2>
        <pre id="body"></pre>
      </div>
    </article>
  </section>
</AppLayout>

<script>
  import {
    applyTransform,
    authorityLabel,
    composeDraft,
    draftText,
    formats,
    getTransformControlState,
    type Draft,
    type TransformAction,
  } from "../../lib/content-engine";
  import { topics } from "../../lib/data/topics";
  import { voiceProfiles } from "../../lib/data/voice";
  import { loadWorkspace, updateWorkspace } from "../../lib/storage";
  import { showToast } from "../../lib/ui";

  const topicFieldEl = document.getElementById("topic-field")!;
  const topicEmptyEl = document.getElementById("topic-empty")!;
  const topicEl = document.getElementById("topic") as HTMLSelectElement;
  const formatEl = document.getElementById("format") as HTMLSelectElement;
  const voiceEl = document.getElementById("voice") as HTMLSelectElement;
  const canvasEl = document.getElementById("canvas")!;
  const canvasContentEl = document.getElementById("canvas-content")!;
  const canvasIdleEl = document.getElementById("canvas-idle")!;
  const controlsEl = document.getElementById("controls")!;
  const titleEl = document.getElementById("title")!;
  const bodyEl = document.getElementById("body")!;
  const channelEl = document.getElementById("channel")!;
  const authorityEl = document.getElementById("authority")!;
  const buzzwordsEl = document.getElementById("buzzwords")!;
  const engagementEl = document.getElementById("engagement")!;
  const voiceBadge = document.getElementById("voice-badge")!;
  const copyBtn = document.getElementById("copy") as HTMLButtonElement;
  const persistMenuBtn = document.getElementById("persist-menu") as HTMLButtonElement;
  const persistDropdown = document.getElementById("persist-dropdown")!;
  const persistSplit = document.getElementById("persist-split")!;

  let current: Draft | null = null;
  let composeReady = false;

  function closePersistMenu() {
    persistDropdown.hidden = true;
    persistMenuBtn.setAttribute("aria-expanded", "false");
  }

  function openPersistMenu() {
    persistDropdown.hidden = false;
    persistMenuBtn.setAttribute("aria-expanded", "true");
  }

  function togglePersistMenu() {
    if (persistDropdown.hidden) openPersistMenu();
    else closePersistMenu();
  }

  function availableTopics(focusTopicIds: string[]) {
    return focusTopicIds
      .map((id) => topics.find((t) => t.id === id))
      .filter((topic): topic is (typeof topics)[number] => Boolean(topic));
  }

  function setDraftActionsEnabled(enabled: boolean) {
    const toggle = (id: string, on: boolean) => {
      const el = document.getElementById(id) as HTMLButtonElement | null;
      if (el) el.disabled = !on;
    };

    toggle("save", enabled);
    toggle("persist-menu", enabled);
    copyBtn.disabled = !enabled;
    copyBtn.hidden = !enabled;

    document.querySelectorAll("[data-action]").forEach((btn) => {
      (btn as HTMLButtonElement).disabled = !enabled;
    });

    controlsEl.classList.toggle("controls--idle", !enabled);
  }

  function showIdleCanvas() {
    current = null;
    canvasEl.classList.add("canvas--idle");
    canvasContentEl.hidden = true;
    canvasIdleEl.hidden = false;
    canvasIdleEl.querySelector(".canvas__idle-title")!.textContent = "No draft yet";
    canvasIdleEl.querySelector(".canvas__idle-note")!.textContent =
      "Choose topic, format, and voice — then compose.";
    titleEl.textContent = "";
    bodyEl.textContent = "";
    setDraftActionsEnabled(false);
  }

  function showEmptyCanvas() {
    current = null;
    canvasEl.classList.add("canvas--idle");
    canvasContentEl.hidden = true;
    canvasIdleEl.hidden = false;
    canvasIdleEl.querySelector(".canvas__idle-title")!.textContent = "No focus topics configured";
    canvasIdleEl.querySelector(".canvas__idle-note")!.textContent =
      "Add topics to your brand before composing technical authority.";
    titleEl.textContent = "";
    bodyEl.textContent = "";
    setDraftActionsEnabled(false);
  }

  function setComposeEnabled(enabled: boolean) {
    composeReady = enabled;
    const generate = document.getElementById("generate") as HTMLButtonElement | null;
    if (generate) generate.disabled = !enabled;
    if (!enabled) setDraftActionsEnabled(false);
    else if (!current) setDraftActionsEnabled(false);
  }

  function hydrateTopics() {
    const ws = loadWorkspace();
    const available = availableTopics(ws.focusTopics);
    const previous = topicEl.value;

    if (!available.length) {
      topicFieldEl.hidden = true;
      topicEmptyEl.hidden = false;
      topicEl.innerHTML = "";
      setComposeEnabled(false);
      showEmptyCanvas();
      return;
    }

    topicFieldEl.hidden = false;
    topicEmptyEl.hidden = true;
    topicEl.innerHTML = available.map((t) => `<option value="${t.id}">${t.label}</option>`).join("");

    const selectedId = available.some((t) => t.id === previous) ? previous : available[0]!.id;
    topicEl.value = selectedId;
    setComposeEnabled(true);

    if (current && !available.some((t) => t.id === current!.topicId)) {
      current = null;
    }

    if (!current) showIdleCanvas();
  }

  const ws = loadWorkspace();
  formatEl.innerHTML = formats.map((f) => `<option value="${f.id}">${f.label}</option>`).join("");
  voiceEl.innerHTML = voiceProfiles
    .map((v) => `<option value="${v.id}" ${v.id === ws.voiceId ? "selected" : ""}>${v.label}</option>`)
    .join("");

  function engagementLabel(signal: number): string {
    if (signal >= 75) return "High";
    if (signal >= 60) return "Medium";
    return "Low";
  }

  function render(draft: Draft) {
    current = draft;
    canvasEl.classList.remove("canvas--idle");
    canvasContentEl.hidden = false;
    canvasIdleEl.hidden = true;
    titleEl.textContent = draft.title;
    bodyEl.textContent = draft.body;
    channelEl.textContent = draft.channelHint;
    authorityEl.textContent = `Authority: ${authorityLabel(draft.authorityTier ?? 0)}`;
    buzzwordsEl.textContent = `Buzzwords: ${draft.buzzwordCount ?? 0}`;
    engagementEl.textContent = `Engagement: ${engagementLabel(draft.signal)}`;
    voiceBadge.textContent = voiceProfiles.find((v) => v.id === draft.voiceId)?.label ?? draft.voiceId;
    updateTransformControls(draft);
    setDraftActionsEnabled(true);
  }

  function updateTransformControls(draft: Draft) {
    document.querySelectorAll("[data-action]").forEach((btn) => {
      const action = (btn as HTMLElement).dataset.action as TransformAction;
      const state = getTransformControlState(draft, action);
      const button = btn as HTMLButtonElement;
      button.disabled = state.disabled;
      button.textContent = state.label;
      button.title = state.hint ?? "";
    });
  }

  function create() {
    if (!composeReady || !topicEl.value) return;
    render(
      composeDraft({
        topicId: topicEl.value,
        formatId: formatEl.value as any,
        voiceId: voiceEl.value as any,
      }),
    );
  }

  document.getElementById("generate")?.addEventListener("click", create);

  document.querySelectorAll("[data-action]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!current) return;
      const action = (btn as HTMLElement).dataset.action as TransformAction;
      const outcome = applyTransform(current, action);
      render(outcome.draft);
      if (!outcome.applied) {
        showToast(outcome.message);
        return;
      }
      if (action === "linkedin" || action === "x") {
        showToast("Variant created without additional source material");
      } else if (outcome.terminal) {
        showToast(outcome.message);
      } else {
        showToast("Draft updated");
      }
    });
  });

  function saveDraft() {
    if (!current) return;
    updateWorkspace((s) => ({
      ...s,
      drafts: [current!, ...s.drafts.filter((d) => d.id !== current!.id)].slice(0, 50),
    }));
    showToast("Saved to library");
    window.dispatchEvent(new Event("eb:workspace"));
  }

  function queueDraft() {
    if (!current) return;
    const channelId =
      current.channelHint === "x" ? "x" : current.channelHint === "youtube" ? "youtube" : "linkedin";
    updateWorkspace((s) => ({
      ...s,
      drafts: [current!, ...s.drafts.filter((d) => d.id !== current!.id)].slice(0, 50),
      pipeline: [
        {
          id: `p_${Date.now()}`,
          draftId: current!.id,
          title: current!.title,
          channelId,
          when: new Date(Date.now() + 86400000 * 2).toISOString(),
          status: "scheduled" as const,
        },
        ...s.pipeline,
      ],
    }));
    showToast("Queued to pipeline");
    window.dispatchEvent(new Event("eb:workspace"));
  }

  async function copyDraft() {
    if (!current) return;
    await navigator.clipboard.writeText(draftText(current));
    showToast("Copied");
  }

  document.getElementById("save")?.addEventListener("click", saveDraft);

  persistMenuBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    if (persistMenuBtn.disabled) return;
    togglePersistMenu();
  });

  persistDropdown.querySelectorAll("[data-persist]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const action = (btn as HTMLElement).dataset.persist;
      closePersistMenu();
      if (action === "save") saveDraft();
      if (action === "queue") queueDraft();
    });
  });

  document.addEventListener("click", (e) => {
    if (!persistSplit.contains(e.target as Node)) closePersistMenu();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closePersistMenu();
  });

  copyBtn.addEventListener("click", copyDraft);

  hydrateTopics();

  window.addEventListener("eb:workspace", hydrateTopics);
</script>

<style>
  .compose {
    display: grid;
    gap: 1rem;
    min-width: 0;
    align-items: start;
  }

  .controls,
  .canvas {
    padding: 1.2rem;
    min-width: 0;
  }

  .canvas {
    position: relative;
  }

  .canvas__copy[hidden] {
    display: none !important;
  }

  .canvas__copy {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink-muted);
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background 0.2s var(--ease);
  }

  .canvas__copy:hover:not(:disabled) {
    color: var(--ink);
    border-color: var(--line-strong);
    background: #f8fafc;
  }

  .canvas__copy:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .controls {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .controls__setup {
    display: grid;
    gap: 0.75rem;
  }

  .controls__section {
    display: grid;
    gap: 0.55rem;
    padding-top: 0.95rem;
    border-top: 1px solid var(--line);
    transition: opacity 0.2s var(--ease);
  }

  .controls--idle .controls__section {
    opacity: 0.42;
  }

  .controls__section--actions {
    padding-top: 0.85rem;
  }

  label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-muted);
  }

  #topic-field[hidden],
  .topic-empty[hidden],
  .canvas__content[hidden],
  .canvas__idle[hidden] {
    display: none !important;
  }

  .topic-empty:not([hidden]) {
    display: grid;
    gap: 0.55rem;
    padding: 0.85rem 0.9rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: #f8fafc;
  }

  select {
    min-height: 42px;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    background: #fff;
    padding: 0.5rem 0.75rem;
    font-weight: 550;
  }

  #generate {
    margin-top: 0.15rem;
  }

  .topic-empty__title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 750;
    color: var(--ink);
  }

  .topic-empty__note {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .topic-empty .btn {
    justify-self: start;
    margin-top: 0.15rem;
  }

  .controls :is(button, select):disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .split-btn {
    display: flex;
    align-items: stretch;
    width: 100%;
  }

  .split-btn__main {
    flex: 1;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    min-height: 38px;
  }

  .split-btn__menu {
    position: relative;
    flex: 0 0 auto;
  }

  .split-btn__trigger {
    min-height: 38px;
    min-width: 38px;
    padding-inline: 0.55rem;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-left: 1px solid rgba(255, 255, 255, 0.22);
  }

  .split-btn__trigger svg {
    display: block;
  }

  .split-btn__dropdown {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.35rem);
    z-index: 5;
    min-width: 11.5rem;
    padding: 0.3rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: var(--shadow-sm);
  }

  .split-btn__dropdown[hidden] {
    display: none !important;
  }

  .split-btn__option {
    display: block;
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: none;
    border-radius: 8px;
    background: transparent;
    text-align: left;
    font-size: 0.84rem;
    font-weight: 650;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.15s var(--ease);
  }

  .split-btn__option:hover {
    background: #f8fafc;
  }

  .transform-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
  }

  .transform-grid .btn {
    justify-content: flex-start;
    min-height: 38px;
    padding-inline: 0.85rem;
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 650;
  }

  .transform-grid .btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    white-space: normal;
    line-height: 1.25;
    text-align: left;
  }

  .hint {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin: 0;
  }

  .canvas--idle {
    padding: 1.35rem 1.4rem;
  }

  .canvas__idle {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 1.15rem;
    border-radius: 12px;
    border: 1px dashed var(--line-strong);
    background: #f8fafc;
  }

  .canvas__idle-title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 750;
    color: var(--ink);
  }

  .canvas__idle-note {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .canvas__content {
    display: grid;
    gap: 0;
    padding-right: 1.75rem;
  }

  .canvas__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.95rem;
  }

  .canvas h2 {
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 750;
    margin-bottom: 0.75rem;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .canvas pre {
    margin: 0;
    white-space: pre-wrap;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--ink-soft);
    max-height: min(52vh, 28rem);
    overflow-x: hidden;
    overflow-y: auto;
    overflow-wrap: anywhere;
    word-break: break-word;
    padding-right: 0.25rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(10, 22, 40, 0.2) transparent;
  }

  .canvas pre::-webkit-scrollbar {
    width: 6px;
  }

  .canvas pre::-webkit-scrollbar-thumb {
    background: rgba(10, 22, 40, 0.18);
    border-radius: 999px;
  }

  @media (min-width: 960px) {
    .compose {
      grid-template-columns: minmax(280px, 320px) minmax(0, 1fr);
    }

    .transform-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
