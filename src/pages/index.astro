---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { withBase } from "../lib/paths";
---

<MarketingLayout
  title="Endless Buzzwords™ — Never run out of technical content"
  description="Never run out of technical content again. One idea. Every platform. Endless Buzzwords keeps your feed technical, senior, and full."
>
  <!-- Cold open: product in motion, brand as hero -->
  <section class="open">
    <div class="container-wide open__grid">
      <div class="open__copy">
        <p class="eyebrow">Technical content operations</p>
        <h1 class="open__brand">Endless Buzzwords<span>™</span></h1>
        <p class="open__lede">
          Never run out of technical content again. Turn one idea into a week of posts — and keep your authority visible across every channel.
        </p>
        <div class="open__cta">
          <a class="btn btn-primary" href={withBase("/app/compose")}>Open workspace</a>
          <a class="btn btn-ghost" href="#product">See the product</a>
        </div>
      </div>

      <div class="feed-rail" id="studio-preview">
        <div class="feed-rail__label">Content Studio · Live</div>
        <div class="studio-card" id="studio-card" aria-live="polite">
          <div class="studio-meta">
            <div class="studio-field">
              <span class="studio-label">Topic</span>
              <span class="studio-value" id="studio-topic">—</span>
            </div>
            <div class="studio-field">
              <span class="studio-label">Format</span>
              <span class="studio-value" id="studio-format">—</span>
            </div>
          </div>
          <div class="studio-draft">
            <h3 class="studio-title" id="studio-title">Generating…</h3>
            <div class="studio-body-wrap">
              <div class="studio-body" id="studio-body"></div>
            </div>
          </div>
          <dl class="studio-metrics">
            <div>
              <dt>Authority</dt>
              <dd id="studio-authority">—</dd>
            </div>
            <div>
              <dt>Buzzwords</dt>
              <dd id="studio-buzzwords">—</dd>
            </div>
            <div>
              <dt>Engagement</dt>
              <dd id="studio-engagement">—</dd>
            </div>
          </dl>
          <div class="studio-actions">
            <button class="studio-btn" type="button" data-transform="senior">Make it more senior</button>
            <button class="studio-btn" type="button" data-transform="buzzwords">Add buzzwords</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Thesis -->
  <section class="thesis" id="thesis">
    <div class="container thesis__inner">
      <h2>You need technical content. You need it constantly.</h2>
      <div class="thesis__cols">
        <p>
          Algorithms reward posting. Posting rewards confidence. Confidence rewards sounding senior — whether or not you had a fresh thought this week.
        </p>
        <p>
          Endless Buzzwords keeps the feed full. Compose from a topic, repackage for every platform, and never let the pipeline go quiet.
        </p>
      </div>
    </div>
  </section>

  <!-- Product narrative -->
  <section class="product" id="product">
    <div class="container-wide">
      <div class="product__intro">
        <p class="eyebrow">The product</p>
        <h2>One idea. Every platform. Forever.</h2>
      </div>

      <div class="product__block">
        <div class="product__copy">
          <h3>Compose</h3>
          <p>
            Start with a topic. Pick a format. Make it more senior, add buzzwords, turn it into thought leadership — or repackage the same idea for LinkedIn, X, and YouTube without starting over.
          </p>
        </div>
        <div class="card product__ui" id="compose-preview">
          <div class="ui-bar"><span></span><span></span><span></span><em>Compose</em></div>
          <pre id="compose-sample">Loading sample…</pre>
        </div>
      </div>

      <div class="product__block product__block--flip">
        <div class="product__copy">
          <h3>Pipeline</h3>
          <p>
            See what's scheduled, what's queued, and how many days until the feed goes quiet. Advance posts as they go out. Never let the calendar run dry.
          </p>
        </div>
        <div class="card product__ui product__ui--light">
          <ul class="mini-pipe">
            <li><strong>Tue · LinkedIn</strong><span>Field note · API design</span></li>
            <li><strong>Thu · X</strong><span>Compressed take · caching</span></li>
            <li><strong>Fri · YouTube</strong><span>60-second script · queued</span></li>
          </ul>
        </div>
      </div>

      <div class="product__block">
        <div class="product__copy">
          <h3>Coverage</h3>
          <p>
            Map the topics you're prepared to post about. Spot gaps before you run out of things to sound authoritative on. Rebalance when a launch needs more airtime.
          </p>
        </div>
        <div class="card product__ui product__ui--light">
          <div class="mini-cover">
            <div><h4>Services</h4><p>API design · Node.js · Auth</p></div>
            <div><h4>Architecture</h4><p>Boundaries · Async · Failure modes</p></div>
            <div><h4>Data</h4><p>Postgres · Caching · Migrations</p></div>
          </div>
        </div>
      </div>

      <div class="product__block product__block--flip">
        <div class="product__copy">
          <h3>Channels & brand</h3>
          <p>
            Connect destinations, set a weekly cadence, and extract as much content as possible from the same idea. One draft becomes a thread, a post, and a short — automatically.
          </p>
        </div>
        <div class="card product__ui product__ui--light">
          <div class="mini-brand">
            <div><span>Authority</span><strong>Senior</strong></div>
            <div><span>Cadence</span><strong>5 / week</strong></div>
            <div><span>Runway</span><strong>Unlimited</strong></div>
            <div><span>Channels</span><strong>2 connected</strong></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who -->
  <section class="who">
    <div class="container">
      <p class="eyebrow">Built for</p>
      <h2>Anyone who needs to stay technical and visible</h2>
      <ul class="who__list">
        <li>
          <strong>Developer creators</strong>
          <span>Keep posting without waiting for inspiration to strike.</span>
        </li>
        <li>
          <strong>Engineering leads</strong>
          <span>Maintain authority across LinkedIn, X, and YouTube from one workspace.</span>
        </li>
        <li>
          <strong>Technical brands</strong>
          <span>Turn one launch into a month of content without hiring an editorial team.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Plans -->
  <section class="plans" id="plans">
    <div class="container">
      <div class="plans__intro">
        <p class="eyebrow">Plans</p>
        <h2>Priced for volume, not originality</h2>
      </div>
      <div class="plans__grid">
        <article class="card plan">
          <h3>Studio</h3>
          <p class="plan__price">$39<span>/mo</span></p>
          <ul>
            <li>Compose + library</li>
            <li>2 connected channels</li>
            <li>Weekly cadence tracking</li>
            <li>1 voice profile</li>
          </ul>
          <a class="btn btn-ghost btn-block" href={withBase("/app")}>Start on Studio</a>
        </article>
        <article class="card plan plan--featured">
          <div class="plan__head">
            <h3>Desk</h3>
            <span class="badge">Common for teams</span>
          </div>
          <p class="plan__price">$99<span>/mo</span></p>
          <ul>
            <li>Everything in Studio</li>
            <li>4 channels</li>
            <li>Coverage maps</li>
            <li>Adaptive Seniority™</li>
          </ul>
          <a class="btn btn-primary btn-block" href={withBase("/app/compose")}>Open Desk</a>
        </article>
        <article class="card plan">
          <h3>Organization</h3>
          <p class="plan__price">$280<span>/mo</span></p>
          <ul>
            <li>Multi-brand desks</li>
            <li>Shared libraries</li>
            <li>Priority channel slots</li>
            <li>Workspace export</li>
          </ul>
          <a class="btn btn-ghost btn-block" href={withBase("/app/brand")}>Configure brand</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Close -->
  <section class="close">
    <div class="container card close__panel">
      <div>
        <h2>Stay technical. Stay visible.</h2>
        <p class="muted">Your content runway is unlimited. Open the workspace and fill the pipeline before the feed goes quiet.</p>
      </div>
      <a class="btn btn-accent" href={withBase("/app/compose")}>Compose the next post</a>
    </div>
  </section>
</MarketingLayout>

<script>
  import {
    applyTransform,
    authorityLabel,
    composeDraft,
    formats,
    getTransformControlState,
    type Draft,
    type TransformAction,
  } from "../lib/content-engine";
  import { topicById } from "../lib/data/topics";

  const sample = document.getElementById("compose-sample");
  const studioCard = document.getElementById("studio-card");
  const studioTopic = document.getElementById("studio-topic");
  const studioFormat = document.getElementById("studio-format");
  const studioTitle = document.getElementById("studio-title");
  const studioBody = document.getElementById("studio-body");
  const studioAuthority = document.getElementById("studio-authority");
  const studioBuzzwords = document.getElementById("studio-buzzwords");
  const studioEngagement = document.getElementById("studio-engagement");

  const heroSamples = [
    { topicId: "apis", formatId: "debug-prompt" as const, voiceId: "pointed" as const, seed: 4242 },
    { topicId: "caching", formatId: "field-note" as const, voiceId: "grounded" as const, seed: 8080 },
    { topicId: "system-design", formatId: "tradeoff" as const, voiceId: "desk" as const, seed: 1337 },
    { topicId: "observability", formatId: "quick-take" as const, voiceId: "curriculum" as const, seed: 9001 },
  ];

  let currentIndex = 0;
  let currentDraft: Draft | null = null;
  let rotateTimer: ReturnType<typeof setInterval> | null = null;
  let userPaused = false;

  function engagementLabel(signal: number): string {
    if (signal >= 75) return "High";
    if (signal >= 60) return "Medium";
    return "Low";
  }

  function renderStudio(draft: Draft) {
    currentDraft = draft;
    const topic = topicById[draft.topicId]?.label ?? draft.topicId;
    const format = formats.find((f) => f.id === draft.formatId)?.label ?? draft.formatId;

    if (studioTopic) studioTopic.textContent = topic;
    if (studioFormat) studioFormat.textContent = format;
    if (studioTitle) studioTitle.textContent = draft.title;
    if (studioBody) studioBody.textContent = draft.body;
    if (studioAuthority) studioAuthority.textContent = authorityLabel(draft.authorityTier ?? 0);
    if (studioBuzzwords) studioBuzzwords.textContent = String(draft.buzzwordCount ?? 0);
    if (studioEngagement) studioEngagement.textContent = engagementLabel(draft.signal);
    updateStudioControls(draft);
  }

  function updateStudioControls(draft: Draft) {
    document.querySelectorAll("[data-transform]").forEach((btn) => {
      const action = (btn as HTMLElement).dataset.transform as TransformAction;
      const state = getTransformControlState(draft, action);
      const button = btn as HTMLButtonElement;
      button.disabled = state.disabled;
      button.textContent = state.label;
      button.title = state.hint ?? "";
    });
  }

  function loadHeroSample(index: number, animate = false) {
    const config = heroSamples[index]!;
    const apply = () => renderStudio(composeDraft(config));

    if (!animate || !studioCard) {
      apply();
      return;
    }

    studioCard.classList.add("is-fading");
    window.setTimeout(() => {
      apply();
      studioCard.classList.remove("is-fading");
    }, 220);
  }

  function startRotation() {
    if (rotateTimer) clearInterval(rotateTimer);
    rotateTimer = setInterval(() => {
      if (userPaused) return;
      currentIndex = (currentIndex + 1) % heroSamples.length;
      loadHeroSample(currentIndex, true);
    }, 5200);
  }

  loadHeroSample(0);
  startRotation();

  document.getElementById("studio-preview")?.addEventListener("mouseenter", () => {
    userPaused = true;
  });

  document.getElementById("studio-preview")?.addEventListener("mouseleave", () => {
    userPaused = false;
  });

  document.querySelectorAll("[data-transform]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!currentDraft) return;
      userPaused = true;
      const action = (btn as HTMLElement).dataset.transform as TransformAction;
      const outcome = applyTransform(currentDraft, action);
      renderStudio(outcome.draft);
      studioCard?.classList.remove("is-fading");
    });
  });

  if (sample) {
    const d = composeDraft({ topicId: "apis", formatId: "field-note", voiceId: "grounded", seed: 2026 });
    sample.textContent = `${d.title}\n\n${d.body}`;
  }
</script>

<style>
  .open {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 2rem;
  }

  .open__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .open__grid > * {
    min-width: 0;
  }

  .open__brand {
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    line-height: 1.08;
    margin: 0.85rem 0 1rem;
    max-width: 12ch;
    padding-top: 0.1em;
  }

  .open__brand span {
    font-size: 0.35em;
    vertical-align: super;
    color: var(--ink-muted);
  }

  .open__lede {
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    color: var(--ink-soft);
    font-weight: 500;
    max-width: 34rem;
    margin-bottom: 1.5rem;
  }

  .open__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .feed-rail {
    background: var(--ink);
    color: #e8eef7;
    border-radius: 24px;
    padding: 1rem;
    box-shadow: var(--shadow-lg);
    animation: float-y 8s ease-in-out infinite;
    min-width: 0;
    overflow: hidden;
  }

  .feed-rail__label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #7ddec9;
    margin-bottom: 0.9rem;
    padding: 0 0.15rem;
  }

  .studio-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    padding: 1.1rem 1.15rem 1.15rem;
    transition: opacity 0.22s ease;
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .studio-card.is-fading {
    opacity: 0.35;
  }

  .studio-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    margin-bottom: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .studio-field {
    display: grid;
    gap: 0.2rem;
  }

  .studio-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8fa3b8;
  }

  .studio-value {
    font-size: 0.88rem;
    font-weight: 650;
    color: #e8eef7;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .studio-draft {
    display: grid;
    gap: 0.55rem;
    min-width: 0;
  }

  .studio-title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 750;
    color: #fff;
    margin: 0;
    line-height: 1.35;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow-wrap: anywhere;
  }

  .studio-body-wrap {
    min-height: 7.5rem;
    overflow: visible;
  }

  .studio-body {
    margin: 0;
    white-space: pre-wrap;
    font-family: var(--font-body);
    font-size: 0.84rem;
    line-height: 1.5;
    color: #b7c6d6;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .studio-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 0.85rem 0 0.95rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
  }

  .studio-metrics div {
    display: grid;
    gap: 0.15rem;
  }

  .studio-metrics dt {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #8fa3b8;
  }

  .studio-metrics dd {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 700;
    color: #e8eef7;
  }

  .studio-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    flex-shrink: 0;
    margin-top: auto;
  }

  .studio-btn {
    flex: 1 1 calc(50% - 0.25rem);
    min-width: 0;
    max-width: 100%;
    padding: 0.38rem 0.65rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.25;
    text-align: center;
    white-space: normal;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #d7e4f0;
    transition:
      background 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .studio-btn:hover:not(:disabled) {
    background: rgba(125, 222, 201, 0.12);
    border-color: rgba(125, 222, 201, 0.35);
    color: #fff;
  }

  .studio-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .thesis {
    padding: clamp(3rem, 6vw, 4.5rem) 0;
    border-block: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.5);
  }

  .thesis__inner h2 {
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    max-width: 18ch;
    margin-bottom: 1.5rem;
  }

  .thesis__cols {
    display: grid;
    gap: 1.25rem;
  }

  .thesis__cols p {
    color: var(--ink-soft);
    font-weight: 500;
    font-size: 1.05rem;
    max-width: 36rem;
  }

  .product {
    padding: clamp(3rem, 7vw, 5rem) 0;
  }

  .product__intro {
    max-width: 36rem;
    margin-bottom: 2.5rem;
  }

  .product__intro h2 {
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    margin-top: 0.45rem;
  }

  .product__block {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
    align-items: center;
  }

  .product__copy h3 {
    font-family: var(--font-body);
    font-size: 1.35rem;
    margin-bottom: 0.55rem;
  }

  .product__copy p {
    color: var(--ink-soft);
    font-weight: 500;
    max-width: 34rem;
  }

  .product__ui {
    overflow: hidden;
    background: var(--ink);
    color: #e8eef7;
  }

  .product__ui--light {
    background: var(--elevated);
    color: var(--ink);
    padding: 1.15rem;
  }

  .ui-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.78rem;
    color: #9db0c5;
  }

  .ui-bar span {
    width: 8px;
