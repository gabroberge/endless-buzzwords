    border-radius: 50%;
    background: #3d4f66;
  }

  .ui-bar span:first-child {
    background: #c9852e;
  }

  .ui-bar em {
    margin-left: auto;
    font-style: normal;
  }

  .product__ui pre {
    margin: 0;
    padding: 1.15rem 1.2rem 1.35rem;
    white-space: pre-wrap;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.55;
    min-height: 11rem;
  }

  .mini-pipe {
    display: grid;
    gap: 0.75rem;
  }

  .mini-pipe li {
    display: grid;
    gap: 0.2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .mini-pipe li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .mini-pipe span {
    color: var(--ink-muted);
    font-size: 0.9rem;
  }

  .mini-cover {
    display: grid;
    gap: 0.85rem;
  }

  .mini-cover h4 {
    font-family: var(--font-body);
    font-size: 0.92rem;
    margin-bottom: 0.2rem;
  }

  .mini-cover p {
    color: var(--ink-muted);
    font-size: 0.88rem;
  }

  .mini-brand {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }

  .mini-brand span {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
