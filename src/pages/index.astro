    font-family: var(--font-body);
    font-size: 1.2rem;
    margin-bottom: 0.35rem;
  }

  .plan__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.35rem;
  }

  .plan__head h3 {
    margin-bottom: 0;
  }

  .plan__head .badge {
    margin-left: auto;
    flex-shrink: 0;
    font-size: 0.65rem;
    padding: 0.2rem 0.55rem;
    letter-spacing: 0.04em;
