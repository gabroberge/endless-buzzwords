---
import { stripBase, withBase } from "../../lib/paths";

const pathname = stripBase(Astro.url.pathname);

const links = [
  { href: withBase("/app"), label: "Pipeline", match: /^\/app\/?$/ },
  { href: withBase("/app/compose"), label: "Compose", match: /^\/app\/compose/ },
  { href: withBase("/app/library"), label: "Library", match: /^\/app\/library/ },
  { href: withBase("/app/coverage"), label: "Coverage", match: /^\/app\/coverage/ },
  { href: withBase("/app/channels"), label: "Channels", match: /^\/app\/channels/ },
  { href: withBase("/app/brand"), label: "Brand", match: /^\/app\/brand/ },
];
---

<aside class="sidebar" aria-label="Workspace">
  <a class="sidebar__brand" href={withBase("/")}>
    <span class="mark" aria-hidden="true"></span>
    <span>
      <strong>Endless Buzzwords</strong>
      <small>Desk</small>
    </span>
  </a>

  <nav class="sidebar__nav">
    {
      links.map((l) => (
        <a href={l.href} class:list={[{ active: l.match.test(pathname) }]} aria-current={l.match.test(pathname) ? "page" : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>

  <div class="sidebar__footer">
    <a href={withBase("/")}>Product site</a>
    <p class="muted" data-cadence-note>Cadence target loading…</p>
  </div>
</aside>

<nav class="mobile-tabbar" aria-label="Workspace mobile">
  <a href={withBase("/app")} class:list={[{ active: /^\/app\/?$/.test(pathname) }]}>Pipe</a>
  <a href={withBase("/app/compose")} class:list={[{ active: pathname.includes("/compose") }]}>Compose</a>
  <a href={withBase("/app/coverage")} class:list={[{ active: pathname.includes("/coverage") }]}>Cover</a>
  <a href={withBase("/app/channels")} class:list={[{ active: pathname.includes("/channels") }]}>Send</a>
  <a href={withBase("/app/brand")} class:list={[{ active: pathname.includes("/brand") }]}>Brand</a>
</nav>

<script>
  import { computeRunwayCoverage } from "../../lib/metrics";
  import { loadWorkspace } from "../../lib/storage";
  function refresh() {
    const ws = loadWorkspace();
    const { runwayDays, coveredSlots } = computeRunwayCoverage(ws);
    const el = document.querySelector("[data-cadence-note]");
    if (!el) return;
    const cadencePart = ws.cadenceTarget != null ? `${ws.cadenceTarget}/week` : "Cadence not set";
    const runway =
      ws.cadenceTarget == null
        ? "runway —"
        : coveredSlots === 0
          ? "no runway"
          : runwayDays >= 14
            ? "runway unlimited"
            : `${runwayDays}d runway`;
    el.textContent = `${cadencePart} · ${runway}`;
  }
  refresh();
  window.addEventListener("eb:workspace", refresh);
</script>

<style>
  .sidebar {
    display: none;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.25rem 1rem;
    background: var(--ink);
    color: #d7dee8;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
  }

  .sidebar__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.35rem 0.5rem;
  }

  .mark {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(145deg, var(--accent), #16485a);
    flex: 0 0 auto;
  }

  .sidebar__brand strong {
    display: block;
    color: #fff;
    font-family: var(--font-display);
    letter-spacing: -0.03em;
    font-size: 0.95rem;
  }

  .sidebar__brand small {
    color: #8fa0b5;
    font-size: 0.75rem;
  }

  .sidebar__nav {
    display: grid;
    gap: 0.25rem;
  }

  .sidebar__nav a {
    padding: 0.7rem 0.85rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.92rem;
    color: #a9b7c9;
  }

  .sidebar__nav a:hover,
  .sidebar__nav a.active {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }

  .sidebar__footer {
    margin-top: auto;
    padding: 0.75rem;
    font-size: 0.82rem;
  }

  .sidebar__footer a {
    display: inline-block;
    margin-bottom: 0.5rem;
    color: #9eb0c4;
  }

  .mobile-tabbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.15rem;
    padding: 0.55rem 0.4rem calc(0.55rem + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.94);
    border-top: 1px solid var(--line);
    backdrop-filter: blur(12px);
  }

  .mobile-tabbar a {
    text-align: center;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ink-muted);
    padding: 0.45rem 0.2rem;
    border-radius: 10px;
  }

  .mobile-tabbar a.active {
    color: var(--accent-hover);
    background: var(--accent-soft);
  }

  @media (min-width: 901px) {
    .sidebar {
      display: flex;
      position: sticky;
      top: 0;
      height: 100vh;
    }

    .mobile-tabbar {
      display: none;
    }
  }
</style>
