---
import { appNavItems } from "../../lib/app-nav";
import { stripBase, withBase } from "../../lib/paths";

const pathname = stripBase(Astro.url.pathname);

const links = appNavItems.map((item) => ({
  href: withBase(item.path),
  label: item.label,
  match: item.match,
  active: item.match.test(pathname),
}));
---

<aside class="sidebar" aria-label="Workspace">
  <a class="sidebar__brand" href={withBase("/")}>
    <span class="mark" aria-hidden="true"></span>
    <span>
      <strong>Endless Buzzwords</strong>
      <small>Desk</small>
    </span>
  </a>

  <nav class="sidebar__nav">
    {
      links.map((l) => (
        <a href={l.href} class:list={[{ active: l.active }]} aria-current={l.active ? "page" : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>

  <div class="sidebar__footer">
    <a href={withBase("/")}>Product site</a>
  </div>
</aside>

<script>
  import { loadWorkspace } from "../../lib/storage";
  function refresh() {
    loadWorkspace();
  }
  refresh();
  window.addEventListener("eb:workspace", refresh);
</script>

<style>
  .sidebar {
    display: none;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.25rem 1rem;
    background: var(--ink);
    color: #d7dee8;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
  }

  .sidebar__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.35rem 0.5rem;
  }

  .mark {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(145deg, var(--accent), #16485a);
    flex: 0 0 auto;
  }

  .sidebar__brand strong {
    display: block;
    color: #fff;
    font-family: var(--font-display);
    letter-spacing: -0.03em;
    font-size: 0.95rem;
  }

  .sidebar__brand small {
    color: #8fa0b5;
    font-size: 0.75rem;
  }

  .sidebar__nav {
    display: grid;
    gap: 0.25rem;
  }

  .sidebar__nav a {
    padding: 0.7rem 0.85rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.92rem;
    color: #a9b7c9;
  }

  .sidebar__nav a:hover,
  .sidebar__nav a.active {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }

  .sidebar__footer {
    margin-top: auto;
    padding: 0.75rem;
    font-size: 0.82rem;
  }

  .sidebar__footer a {
    display: inline-block;
    margin-bottom: 0.5rem;
    color: #9eb0c4;
  }

  @media (min-width: 901px) {
    .sidebar {
      display: flex;
      position: sticky;
      top: 0;
      height: 100vh;
    }
  }
</style>
