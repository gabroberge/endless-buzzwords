---
interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow = "Desk" } = Astro.props;
---

<header class="topbar">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
  </div>
  <div class="topbar__meta">
    <span class="badge" data-brand-badge>Brand</span>
    <span class="badge badge-muted" data-authority-badge>Authority</span>
    <span class="badge badge-muted" data-channels-badge>Channels</span>
  </div>
</header>

<script>
  import { loadWorkspace } from "../../lib/storage";
  import { computeOpsMetrics } from "../../lib/metrics";

  function refresh() {
    const ws = loadWorkspace();
    const m = computeOpsMetrics(ws);
    const brand = document.querySelector("[data-brand-badge]");
    const authority = document.querySelector("[data-authority-badge]");
    const channels = document.querySelector("[data-channels-badge]");
    if (brand) {
      brand.textContent = ws.brandName.trim() || "Brand not configured";
      brand.classList.toggle("badge-muted", !ws.brandName.trim());
    }
    if (authority) authority.textContent = `Authority: ${m.authorityLevel}`;
    if (channels) {
      const n = ws.channels.filter((c) => c.connected).length;
      channels.textContent = n ? `${n} channels connected` : "No channels connected";
      channels.classList.toggle("badge-muted", n === 0);
    }
  }

  refresh();
  window.addEventListener("eb:workspace", refresh);
</script>

<style>
  .topbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.35rem 1.5rem 0.35rem;
  }

  h1 {
    font-size: clamp(1.45rem, 2vw, 1.85rem);
    margin-top: 0.2rem;
  }

  .topbar__meta {
    display: none;
    gap: 0.45rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  @media (min-width: 720px) {
    .topbar__meta {
      display: flex;
    }
  }

  @media (max-width: 900px) {
    .topbar {
      padding: 1rem 1rem 0.25rem;
    }
  }
</style>
